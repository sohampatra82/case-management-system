<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console - New Case</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .input {
            @apply w-full px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-blue-500;
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs">
                        <i class="fa-solid fa-gauge-high w-3.5"></i> Dashboard
                    </a>

                    <a href="/admin-case"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white rounded-lg text-xs">
                        <i class="fa-solid fa-briefcase w-3.5"></i> Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs">
                        <i class="fa-solid fa-chart-bar w-3.5"></i> Reports
                    </a>

                    <a href="/admin-users"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs">
                        <i class="fa-solid fa-users w-3.5"></i> Users
                    </a>
                </nav>
            </div>

            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i> Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">
                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>
                    <h2 class="text-sm font-semibold sm:hidden">BLCMS</h2>
                </div>
                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            <%= currentUser ? currentUser.fullName : 'Anita Verma' %>
                        </p>
                        <p class="text-xs text-emerald-600">
                            <%= currentUser ? currentUser.role : 'SUPER_ADMIN' %>
                                <%= currentUser && currentUser.zone ? `· ${currentUser.zone}` : '· All Zones' %>
                        </p>
                    </div>

                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                        <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'AV' %>
                </div>
            </div>
            </div>

            <!-- Content -->
<div class=" flex-1 overflow-auto p-4 md:p-6 space-y-4">

                            <form action="/new-case" method="POST" class="max-w-5xl mx-auto text-sm">

                                <!-- Header -->
                                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">

                                    <!-- Left Section -->
                                    <div>
                                        <h1 class="text-lg font-semibold text-slate-800">
                                            Create New Case
                                        </h1>
                                        <p class="text-sm text-slate-500 mt-1">
                                            Fill all mandatory fields to register a new SARFAESI case
                                        </p>
                                    </div>

                                    <!-- Right Section -->
                                    <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                                        <button type="button" onclick="window.location.href='/master-data'"
                                            class="w-full sm:w-auto bg-slate-600 hover:bg-slate-700 text-white px-5 py-3 rounded-xl text-sm font-medium flex items-center justify-center gap-2 shadow-sm transition">
                                            <i class="fa-solid fa-database"></i>
                                            Master Data
                                        </button>

                                        <button type="submit"
                                            class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl text-sm font-medium flex items-center justify-center gap-2 shadow-sm transition">
                                            <i class="fa-solid fa-floppy-disk"></i>
                                            Save Case
                                        </button>
                                    </div>

                                </div>

                                <!-- Step 1: Identity & Assignment -->
                                <div class="bg-white rounded-3xl shadow p-6 mb-6">

                                    <h2 class="text-base font-semibold text-blue-600 mb-5 flex items-center gap-2">
                                        <i class="fa-solid fa-user text-sm"></i>
                                        Identity & Assignment
                                    </h2>

                                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Borrower Name <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" name="borrowerName" required
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-500 outline-none"
                                                placeholder="Full borrower name">
                                        </div>

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Bank <span class="text-red-500">*</span>
                                            </label>
                                            <select id="bankSelect" name="bank" required onchange="loadZones()"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                                <option value="">Select Bank</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Zone <span class="text-red-500">*</span>
                                            </label>
                                            <select id="zoneSelect" name="zone" required onchange="loadRegions()"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                                <option value="">Select Zone</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Region <span class="text-red-500">*</span>
                                            </label>
                                            <select id="regionSelect" name="region" required onchange="loadBranches()"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                                <option value="">Select Region</option>
                                            </select>
                                        </div>

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Branch <span class="text-red-500">*</span>
                                            </label>
                                            <select id="branchSelect" name="branch" required
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                                <option value="">Select Branch</option>
                                            </select>
                                        </div>

                                        <!-- <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Loan Account Number <span class="text-red-500">*</span>
                                            </label>
                                            <input type="text" name="loanAccountNumber" required
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div> -->

                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">
                                                Current Stage
                                            </label>
                                        <select name="currentStage"
                                            class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500">
                                        
                                            <option value="ALLOTMENT">ALLOTMENT</option>
                                            <option value="Section 13(2)">Section 13(2)</option>
                                            <option value="Section 13(4)">Section 13(4)</option>
                                            <option value="Section 14">Section 14</option>
                                            <option value="Possession">Possession</option>
                                            <option value="Sale">Sale</option>
                                        
                                            <!-- ✅ Added these two important stages -->
                                            <option value="Sale Completed">Sale Completed</option>
                                            <option value="Completed">Completed</option>
                                        
                                            <option value="Close">Close</option>
                                        </select>
                                        </div>

                                    </div>
                                </div>

                                <!-- Step 2: Legal Timeline -->
                                <div class="bg-white rounded-3xl shadow p-6 mb-6">

                                    <h2 class="text-base font-semibold text-blue-600 mb-5">
                                        Legal Timeline
                                    </h2>

                                    <div class="grid md:grid-cols-3 gap-5">
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Allotment Date</label>
                                            <input type="date" name="allotmentDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">13(2) Notice
                                                Date</label>
                                            <input type="date" name="noticeDate13_2"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Ack Date</label>
                                            <input type="date" name="ackDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">13(4) Notice
                                                Date</label>
                                            <input type="date" name="noticeDate13_4"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Publication
                                                Date</label>
                                            <input type="date" name="publicationDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                    </div>
                                </div>

                                <!-- Step 3: Court Proceedings -->
                                <div class="bg-white rounded-3xl shadow p-6 mb-6">

                                    <h2 class="text-base font-semibold text-blue-600 mb-5">
                                        Section 14 & Court Proceedings
                                    </h2>

                                    <div class="grid md:grid-cols-3 gap-5">
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Court</label>
                                            <input type="text" name="court"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Filed By</label>
                                            <input type="text" name="filedBy"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Application
                                                Date</label>
                                            <input type="date" name="applicationDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Filing Date</label>
                                            <input type="date" name="filingDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Hearing Date</label>
                                            <input type="date" name="hearingDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Order Date</label>
                                            <input type="date" name="orderDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div class="md:col-span-3">
                                            <label class="block text-slate-700 font-medium mb-2">Advocate
                                                Commissioner</label>
                                            <input type="text" name="advocateCommissioner"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                    </div>
                                </div>

                                <!-- Step 4: Police, Possession & Sale -->
                                <div class="bg-white rounded-3xl shadow p-6 mb-6">

                                    <h2 class="text-base font-semibold text-blue-600 mb-5">
                                        Police, Possession & Sale
                                    </h2>

                                    <div class="grid md:grid-cols-3 gap-5">
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Police Letter
                                                Date</label>
                                            <input type="date" name="policeLetterDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Cost Receive
                                                Date</label>
                                            <input type="date" name="costReceiveDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Cost Deposit
                                                Date</label>
                                            <input type="date" name="costDepositDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Pre-Intimation
                                                Date</label>
                                            <input type="date" name="preIntimationDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Possession Date</label>
                                            <input type="date" name="possessionDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                        <div>
                                            <label class="block text-slate-700 font-medium mb-2">Sale Date</label>
                                            <input type="date" name="saleDate"
                                                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl outline-none">
                                        </div>
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="bg-white rounded-3xl shadow p-6">

                                    <h2 class="text-base font-semibold text-blue-600 mb-4">
                                        Initial Remarks
                                    </h2>

                                    <textarea name="initialRemarks" rows="5"
                                        placeholder="Add important observations, instructions or notes..."
                                        class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-2xl resize-y outline-none"></textarea>

                                </div>

                            </form>
                    </div>
                </div>
            </div>

            <script>
                // ==================== MASTER DATA CASCADING DROPDOWNS ====================
                async function loadBanks() {
                    try {
                        const res = await fetch('/master-data/banks');
                        const banks = await res.json();
                        const select = document.getElementById('bankSelect');
                        select.innerHTML = '<option value="">Select Bank</option>' +
                            banks.map(b => `<option value="${b._id}">${b.bankName}</option>`).join('');
                    } catch (e) {
                        console.error("Error loading banks", e);
                    }
                }

                async function loadZones() {
                    const bankId = document.getElementById('bankSelect').value;
                    const zoneSelect = document.getElementById('zoneSelect');
                    zoneSelect.innerHTML = '<option value="">Select Zone</option>';

                    if (!bankId) return;

                    try {
                        const res = await fetch(`/master-data/zones?bankId=${bankId}`);
                        const zones = await res.json();
                        zoneSelect.innerHTML = '<option value="">Select Zone</option>' +
                            zones.map(z => `<option value="${z._id}">${z.zoneName}</option>`).join('');
                    } catch (e) {
                        console.error("Error loading zones", e);
                    }
                }

                async function loadRegions() {
                    const zoneId = document.getElementById('zoneSelect').value;
                    const regionSelect = document.getElementById('regionSelect');
                    regionSelect.innerHTML = '<option value="">Select Region</option>';

                    if (!zoneId) return;

                    try {
                        const res = await fetch(`/master-data/regions?zoneId=${zoneId}`);
                        const regions = await res.json();
                        regionSelect.innerHTML = '<option value="">Select Region</option>' +
                            regions.map(r => `<option value="${r._id}">${r.regionName}</option>`).join('');
                    } catch (e) {
                        console.error("Error loading regions", e);
                    }
                }

                async function loadBranches() {
                    const regionId = document.getElementById('regionSelect').value;
                    const branchSelect = document.getElementById('branchSelect');
                    branchSelect.innerHTML = '<option value="">Select Branch</option>';

                    if (!regionId) return;

                    try {
                        const res = await fetch(`/master-data/branches?regionId=${regionId}`);
                        const branches = await res.json();
                        branchSelect.innerHTML = '<option value="">Select Branch</option>' +
                            branches.map(b => `<option value="${b._id}">${b.branchName}</option>`).join('');
                    } catch (e) {
                        console.error("Error loading branches", e);
                    }
                }

                // Initialize on page load
                window.onload = () => {
                    loadBanks();
                };

                // Sidebar Functions
                function logout() {
                    if (confirm('Logout?')) window.location.href = '/';
                }

                function openSidebar() {
                    document.getElementById('sidebar').classList.add('open');
                    document.getElementById('sidebarOverlay').classList.add('active');
                }

                function closeSidebar() {
                    document.getElementById('sidebar').classList.remove('open');
                    document.getElementById('sidebarOverlay').classList.remove('active');
                }
            </script>

</body>

</html>