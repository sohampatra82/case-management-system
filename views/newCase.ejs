  <script>
    let allCases = [];

    // Color & Label Helpers
    const zoneColor = z => ({ North: 'bg-sky-100 text-sky-700', South: 'bg-teal-100 text-teal-700', East: 'bg-violet-100 text-violet-700', West: 'bg-pink-100 text-pink-700', Central: 'bg-slate-200 text-slate-600' }[z] || 'bg-gray-100 text-gray-600');

    const stageColor = s => {
        if (!s) return 'bg-gray-100 text-gray-600';
        if (s.includes('13(4)')) return 'bg-orange-100 text-orange-700';
        if (s.includes('13(2)')) return 'bg-amber-100 text-amber-700';
        if (s.includes('Possession')) return 'bg-blue-100 text-blue-700';
        if (s.includes('14')) return 'bg-red-100 text-red-700';
        if (s.includes('Sale')) return 'bg-emerald-100 text-emerald-700';
        return 'bg-gray-100 text-gray-600';
    };

    async function fetchCases() {
        const tbody = document.getElementById('casesTableBody');
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-12"><i class="fa-solid fa-spinner fa-spin text-blue-500 text-xl"></i></td></tr>`;

        try {
            const response = await fetch('/admin-case');   // Change to '/api/cases' if needed

            if (!response.ok) throw new Error('Server error');

            const data = await response.json();
            console.log("📥 Cases received from backend:", data);

            allCases = data.map((c, index) => ({
                ...c,
                si: data.length - index,
                account: c.accountName || 'N/A',
                bank: c.bank || 'N/A',
                branch: c.branch || '-',
                zone: c.zone || 'N/A',
                stage: c.currentStage || 'ALLOTMENT'
            }));

            renderCases(allCases);

        } catch (error) {
            console.error("Fetch error:", error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-red-500 py-12 text-sm">
                        ❌ Failed to load cases<br>
                        <small>Check console (F12) and make sure backend is running</small>
                    </td>
                </tr>`;
        }
    }

    function renderCases(list) {
        const tbody = document.getElementById('casesTableBody');
        tbody.innerHTML = '';

        document.getElementById('caseCount').textContent = `${list.length} case${list.length !== 1 ? 's' : ''} found`;

        if (list.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-slate-400 py-12">No cases found</td></tr>`;
            return;
        }

        list.forEach(c => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50';
            tr.innerHTML = `
                <td class="font-medium text-slate-400">${c.si}</td>
                <td class="font-semibold text-slate-800">${c.account}</td>
                <td class="text-slate-500 hidden md:table-cell">${c.bank}</td>
                <td class="text-slate-600">${c.branch}</td>
                <td><span class="stage-pill ${zoneColor(c.zone)}">${c.zone}</span></td>
                <td><span class="stage-pill ${stageColor(c.stage)}">${c.stage}</span></td>
                <td>
                    <button onclick="viewCase('${c._id}')" class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 text-xs">
                        <i class="fa-solid fa-eye"></i> View
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function filterCases() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        const filtered = allCases.filter(c =>
            !q ||
            c.account.toLowerCase().includes(q) ||
            (c.branch && c.branch.toLowerCase().includes(q))
        );
        renderCases(filtered);
    }

    function viewCase(id) {
        if (id) window.location.href = `/case-view/${id}`;
        else alert("Case ID not found");
    }

    // Show success message
    function checkSuccess() {
        const params = new URLSearchParams(window.location.search);
        if (params.get('success') === 'true') {
            const div = document.createElement('div');
            div.className = "bg-green-50 border border-green-300 text-green-700 px-4 py-3 rounded-2xl mb-4 text-sm";
            div.textContent = "✅ New case created successfully!";
            document.querySelector('.flex-1.overflow-auto').prepend(div);

            setTimeout(() => div.remove(), 5000);
            window.history.replaceState({}, '', '/admin-case');
        }
    }

    // Initialize
    window.onload = () => {
        fetchCases();
        checkSuccess();
        document.getElementById('searchInput').addEventListener('input', filterCases);
    };

            function logout() {
                    if (confirm('Logout?')) window.location.href = '/';
                }

                function openSidebar() {
                    document.getElementById('sidebar').classList.add('open');
                    document.getElementById('sidebarOverlay').classList.add('active');
                }

                function closeSidebar() {
                    document.getElementById('sidebar').classList.remove('open');
                    document.getElementById('sidebarOverlay').classList.remove('active');
                }
</script>

