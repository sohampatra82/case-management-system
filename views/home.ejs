<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CaseFlow - Select Role</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="/css/home.css">
   
</head>

<body>
    <div class="container">
        <div class="header">
            <!-- <div class="logo">CF</div> -->
            <h1>CaseFlow</h1>
            <p class="subtitle">Secure Case Management System</p>
        </div>

        <div class="roles-wrapper">

            <!-- Super Admin -->
            <div class="role-card super-admin" onclick="selectRole('super-admin', '/admin-login')">
                <div class="card-content">
                    <div class="icon-wrapper">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="role-title">Super Admin</div>
                    <div class="role-desc">Full system access &amp; control</div>
                    <button class="login-btn">
                        Login Now <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Zonal User -->
            <div class="role-card zonal-user" onclick="selectRole('zonal-user', '/zonal-login')">
                <div class="card-content">
                    <div class="icon-wrapper">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="role-title">Zonal User</div>
                    <div class="role-desc">Manage zonal operations</div>
                    <button class="login-btn">
                        Login Now <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Branch User -->
            <div class="role-card branch-user" onclick="selectRole('branch-user', '/branch-login')">
                <div class="card-content">
                    <div class="icon-wrapper">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="role-title">Branch User</div>
                    <div class="role-desc">Handle branch level cases</div>
                    <button class="login-btn">
                        Login Now <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Regional Admin -->
            <div class="role-card regional-admin" onclick="selectRole('regional-admin', '/regional-login')">
                <div class="card-content">
                    <div class="icon-wrapper">
                        <i class="fas fa-users-cog"></i>
                    </div>
                    <div class="role-title">Regional User</div>
                    <div class="role-desc">Oversee regional activities</div>
                    <button class="login-btn">
                        Login Now <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

        </div>

        <div class="footer">
            © 2026 CaseFlow • All Rights Reserved
        </div>
    </div>

    <script>
        function selectRole(role, route) {
            localStorage.setItem('selectedRole', role);
            window.location.href = route;
        }
    </script>
</body>

</html>