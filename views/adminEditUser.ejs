<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body class="bg-slate-100">

    <div class="max-w-2xl mx-auto mt-10 bg-white rounded-2xl shadow p-8">
        <h1 class="text-2xl font-semibold mb-6">Edit User</h1>

        <form action="/admin-users/edit/<%= user.model %>/<%= user._id %>" method="POST">

            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                <input type="text" name="fullName" value="<%= user.fullName %>"
                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-500">
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Username / Login ID</label>
                <input type="text" name="username" value="<%= user.username || user.loginId %>"
                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-500">
            </div>

            <% if (user.model !=="Admin" ) { %>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Zone</label>
                    <select name="zone" class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                        <option value="north" <%=user.zone==='north' ? 'selected' : '' %>>North</option>
                        <option value="south" <%=user.zone==='south' ? 'selected' : '' %>>South</option>
                        <option value="east" <%=user.zone==='east' ? 'selected' : '' %>>East</option>
                        <option value="west" <%=user.zone==='west' ? 'selected' : '' %>>West</option>
                        <option value="central" <%=user.zone==='central' ? 'selected' : '' %>>Central</option>
                    </select>
                </div>

                <% if (user.model==="Branch" ) { %>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Bank / Branch Name</label>
                        <input type="text" name="bank" value="<%= user.bank || '' %>"
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                    </div>
                    <% } %>
                        <% } %>

                            <div class="flex gap-4 mt-8">
                                <a href="/admin-users"
                                    class="flex-1 text-center py-3 border border-slate-300 rounded-xl font-medium hover:bg-slate-50">
                                    Cancel
                                </a>
                                <button type="submit"
                                    class="flex-1 bg-blue-600 text-white py-3 rounded-xl font-medium hover:bg-blue-700">
                                    Save Changes
                                </button>
                            </div>
        </form>
    </div>

</body>

</html>