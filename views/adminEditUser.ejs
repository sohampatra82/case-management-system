<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body class="bg-slate-100">

    <div class="max-w-2xl mx-auto mt-10 bg-white rounded-2xl shadow p-8">
        <h1 class="text-2xl font-semibold mb-6 flex items-center gap-2">
            <i class="fas fa-user-edit text-blue-600"></i>
            Edit <%= user.model %> User
        </h1>

        <form method="POST" action="/admin-users/edit/<%= user.model %>/<%= user._id %>">

            <!-- Full Name -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                <input type="text" name="fullName" value="<%= user.fullName || '' %>"
                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-500"
                    required>
            </div>

            <!-- Username / Login ID -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">
                    <%= user.model==='Admin' ? 'Username' : 'Login ID' %>
                </label>
                <input type="text" name="<%= user.model === 'Admin' ? 'username' : 'loginId' %>"
                    value="<%= user.username || user.loginId || '' %>"
                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-500"
                    required>
            </div>

            <% if (user.model !=="Admin" ) { %>

                <!-- Bank -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Bank</label>
                    <select name="bank" class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                        <option value="">Select Bank</option>
                        <% banks.forEach(bank=> { %>
                            <option value="<%= bank._id %>" <%=String(user.bank)===String(bank._id) ? 'selected' : '' %>
                                >
                                <%= bank.bankName %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <!-- Zone -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Zone</label>
                    <select name="zone" class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                        <option value="">Select Zone</option>
                        <% zones.forEach(zone=> { %>
                            <option value="<%= zone._id %>" <%=String(user.zone)===String(zone._id) ? 'selected' : '' %>
                                >
                                <%= zone.zoneName %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <% if (user.model==="Regional" || user.model==="Branch" ) { %>
                    <!-- Region -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Region</label>
                        <select name="region" class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                            <option value="">Select Region</option>
                            <% regions.forEach(region=> { %>
                                <option value="<%= region._id %>" <%=String(user.region)===String(region._id)
                                    ? 'selected' : '' %>>
                                    <%= region.regionName %>
                                </option>
                                <% }); %>
                        </select>
                    </div>
                    <% } %>

                        <% if (user.model==="Branch" ) { %>
                            <!-- Branch Name -->
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-slate-700 mb-1">Branch Name</label>
                                <input type="text" name="branchName"
                                    value="<%= user.branch ? user.branch.branchName : '' %>"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                            </div>
                            <% } %>

                                <% } %>

                                    <div class="flex gap-4 mt-8">
                                        <a href="/admin-users"
                                            class="flex-1 text-center py-3 border border-slate-300 rounded-xl font-medium hover:bg-slate-50 transition">
                                            Cancel
                                        </a>
                                        <button type="submit"
                                            class="flex-1 bg-blue-600 text-white py-3 rounded-xl font-medium hover:bg-blue-700 transition">
                                            Save Changes
                                        </button>
                                    </div>
        </form>
    </div>

</body>

</html>