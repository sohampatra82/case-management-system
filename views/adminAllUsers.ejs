<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .user-circle {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            border-radius: 9999px;
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">

                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>

                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>

                    <a href="/admin-users"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>
<a href="/master-data"
    class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
    <i class="fa-solid fa-database w-3.5 text-center"></i>
    Master Data
</a>
                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">

                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>

                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">
                        BLCMS
                    </h2>
                </div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            <%= currentUser ? currentUser.fullName : 'Anita Verma' %>
                        </p>
                        <p class="text-xs text-emerald-600">
                            <%= currentUser ? currentUser.role : 'SUPER_ADMIN' %>
                                <%= currentUser && currentUser.zone ? `· ${currentUser.zone}` : '· All Zones' %>
                        </p>
                    </div>

                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                        <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'AV' %>
                            </div>
                        </div>
            </div>

            <!-- PAGE CONTENT START -->
        <div class=" flex-1 overflow-auto p-6 bg-slate-50 text-sm">
                            <div class="max-w-6xl mx-auto">

                                <!-- Header -->
                                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-6">

                                    <!-- Left Section -->
                                    <div>
                                        <h1 class="text-sm font-semibold text-slate-900">
                                            System Users
                                        </h1>

                                        <p class="text-sm text-slate-600 mt-1">
                                            Manage platform access and role scopes.
                                        </p>
                                    </div>

                                    <!-- Right Section -->
                                    <a href="/create-accounts"
                                        class="w-full sm:w-auto flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
                                        <i class="fa-solid fa-plus text-sm"></i>
                                        Create Account
                                    </a>

                                </div>

                                <!-- Active Accounts Card -->
                                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">

                                    <div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center">
                                        <div>
                                            <h2 class="font-semibold text-sm text-slate-900">Active Accounts</h2>
                                            <p class="text-sm text-slate-500">
                                                <%= totalUsers %> total users in the system
                                            </p>
                                        </div>
                                    </div>

                                    <div class="overflow-x-auto">
                                        <table class="w-full text-sm">
                                            <thead>
                                                <tr class="border-b border-slate-200 bg-slate-50">
                                                    <th
                                                        class="px-6 py-4 text-left font-medium text-slate-500 uppercase tracking-wider">
                                                        User
                                                    </th>
                                                    <th
                                                        class="px-6 py-4 text-left font-medium text-slate-500 uppercase tracking-wider">
                                                        Username
                                                    </th>
                                                    <th
                                                        class="px-6 py-4 text-left font-medium text-slate-500 uppercase tracking-wider">
                                                        Role
                                                    </th>
                                                    <th
                                                        class="px-6 py-4 text-left font-medium text-slate-500 uppercase tracking-wider">
                                                        Scope /
                                                        Access Level</th>
                                                    <th
                                                        class="px-6 py-4 text-center font-medium text-slate-500 uppercase tracking-wider">
                                                        Actions</th>
                                                </tr>
                                            </thead>

                                            <tbody class="divide-y divide-slate-100">
                                                <% users.forEach(user=> { %>
                                                    <tr class="hover:bg-slate-50 transition-colors">

                                                        <!-- User Info -->
                                                        <td class="px-6 py-4">
                                                            <div class="flex items-center gap-3">
                                                                <div
                                                                    class="user-circle bg-<%= user.color %>-100 text-<%= user.color %>-700 text-sm">
                                                                    <%= user.initials %>
                                                                </div>
                                                                <div>
                                                                    <p class="font-medium text-slate-900">
                                                                        <%= user.fullName %>
                                                                    </p>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Username -->
                                                        <td class="px-6 py-4">
                                                            <span class="font-mono text-sm text-slate-600">
                                                                <%= user.username %>
                                                            </span>
                                                        </td>

                                                        <!-- Role -->
                                                        <td class="px-6 py-4">
                                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
                                            <%= user.role === 'SUPER_ADMIN' ? 'bg-blue-100 text-blue-700' : 
                                               user.role === 'ZONAL' ? 'bg-violet-100 text-violet-700' : 
                                               user.role === 'REGIONAL' ? 'bg-emerald-100 text-emerald-700' : 
                                               'bg-amber-100 text-amber-700' %>">
                                                                <%= user.role %>
                                                            </span>
                                                        </td>

                                                        <!-- Scope -->
                                                        <td class="px-6 py-4">
                                                            <div
                                                                class="flex items-center gap-1.5 text-slate-600 text-sm">
                                                                <i
                                                                    class="fa-solid <%= user.type === 'ADMIN' ? 'fa-globe text-emerald-500' : 'fa-map-marker-alt text-amber-500' %>"></i>
                                                                <span>
                                                                    <%= user.scope %>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <!-- Actions -->
                                                        <td class="px-6 py-4 text-center">
                                                            <div class="flex items-center justify-center gap-2">
                                                                <!-- Edit Button -->
                                                                <a href="/admin-users/edit/<%= user.model %>/<%= user.id %>"
                                                                    class="px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded-xl text-xs font-medium flex items-center gap-1.5 transition-colors">
                                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                                    <span>Edit</span>
                                                                </a>

                                                                <!-- Delete Button -->
                                                                <button
                                                                    onclick="deleteUser('<%= user.model %>', '<%= user.id %>', '<%= user.fullName %>')"
                                                                    class="px-4 py-2 bg-red-100 hover:bg-red-200 text-red-700 rounded-xl text-xs font-medium flex items-center gap-1.5 transition-colors">
                                                                    <i class="fa-solid fa-trash"></i>
                                                                    <span>Delete</span>
                                                                </button>
                                                            </div>
                                                        </td>

                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                    </div>
                    <!-- PAGE CONTENT END -->

                </div>
            </div>

            <script>
                function logout() {
                    if (confirm('Logout?')) window.location.href = '/';
                }

                function openSidebar() {
                    document.getElementById('sidebar').classList.add('open');
                    document.getElementById('sidebarOverlay').classList.add('active');
                }

                function closeSidebar() {
                    document.getElementById('sidebar').classList.remove('open');
                    document.getElementById('sidebarOverlay').classList.remove('active');
                }
            </script>
            <script>
                async function deleteUser(model, id, name) {
                    if (!confirm(`⚠️ Are you sure you want to permanently delete "${name}"?`)) {
                        return;
                    }

                    try {
                        const response = await fetch(`/admin-users/delete/${model}/${id}`, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' }
                        });

                        const data = await response.json();

                        if (data.success) {
                            alert("✅ User deleted successfully!");
                            window.location.reload();
                        } else {
                            alert("❌ " + (data.message || "Failed to delete user"));
                        }
                    } catch (error) {
                        console.error(error);
                        alert("❌ Server error while deleting user");
                    }
                }
            </script>
</body>

</html>