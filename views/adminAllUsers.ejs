<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .user-circle {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            border-radius: 9999px;
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">

                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>

                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>

                    <a href="/admin-users"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>

                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">

                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>

                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">
                        BLCMS
                    </h2>
                </div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            Anita Verma
                        </p>
                        <p class="text-xs text-emerald-600">
                            SUPER_ADMIN · All Zones
                        </p>
                    </div>

                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                        AV
                    </div>
                </div>
            </div>

            <!-- PAGE CONTENT START -->
            <div class="flex-1 overflow-auto p-6 bg-slate-50 text-sm">
                <div class="max-w-6xl mx-auto">
            
                    <!-- Header -->
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h1 class="text-sm font-semibold text-slate-900">
                                System Users
                            </h1>
            
                            <p class="text-sm text-slate-600 mt-1">
                                Manage platform access and role scopes.
                            </p>
                        </div>
            
                        <a href="/create-accounts"
                            class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
                            <i class="fa-solid fa-plus text-sm"></i>
                            Create Account
                        </a>
                    </div>
            
                    <!-- Active Accounts Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            
                        <div class="px-6 py-5 border-b border-slate-100">
                            <h2 class="font-semibold text-sm text-slate-900">
                                Active Accounts
                            </h2>
            
                            <p class="text-sm text-slate-500">
                                All seeded test accounts in the system.
                            </p>
                        </div>
            
                        <!-- Table -->
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
            
                                <thead>
                                    <tr class="border-b border-slate-200 bg-slate-50">
            
                                        <th class="px-6 py-4 text-left text-sm font-medium text-slate-500 uppercase tracking-wider">
                                            User
                                        </th>
            
                                        <th class="px-6 py-4 text-left text-sm font-medium text-slate-500 uppercase tracking-wider">
                                            Username
                                        </th>
            
                                        <th class="px-6 py-4 text-left text-sm font-medium text-slate-500 uppercase tracking-wider">
                                            Role
                                        </th>
            
                                        <th class="px-6 py-4 text-left text-sm font-medium text-slate-500 uppercase tracking-wider">
                                            Scope / Access Level
                                        </th>
            
                                    </tr>
                                </thead>
            
                                <tbody class="divide-y divide-slate-100">
            
                                    <!-- Anita -->
                                    <tr class="hover:bg-slate-50 transition-colors">
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
            
                                                <div class="user-circle bg-blue-100 text-blue-700 text-sm">
                                                    AN
                                                </div>
            
                                                <div>
                                                    <p class="font-medium text-slate-900 text-sm">
                                                        Anita Verma
                                                    </p>
                                                </div>
            
                                            </div>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm text-slate-600">
                                                superadmin
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-700">
            
                                                <i class="fa-solid fa-shield-halved mr-1 text-sm"></i>
            
                                                SUPER ADMIN
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-1.5 text-slate-600 text-sm">
                                                <i class="fa-solid fa-globe text-emerald-500 text-sm"></i>
                                                <span>All Zones (Global)</span>
                                            </div>
                                        </td>
            
                                    </tr>
            
                                    <!-- Rakesh -->
                                    <tr class="hover:bg-slate-50 transition-colors">
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
            
                                                <div class="user-circle bg-purple-100 text-purple-700 text-sm">
                                                    RA
                                                </div>
            
                                                <div>
                                                    <p class="font-medium text-slate-900 text-sm">
                                                        Rakesh Mehta
                                                    </p>
                                                </div>
            
                                            </div>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm text-slate-600">
                                                zonal.north
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-violet-100 text-violet-700">
                                                ZONAL
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-1.5 text-slate-600 text-sm">
                                                <i class="fa-solid fa-map-marker-alt text-amber-500 text-sm"></i>
                                                <span>Zone: North</span>
                                            </div>
                                        </td>
            
                                    </tr>
            
                                    <!-- Priya -->
                                    <tr class="hover:bg-slate-50 transition-colors">
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
            
                                                <div class="user-circle bg-pink-100 text-pink-700 text-sm">
                                                    PR
                                                </div>
            
                                                <div>
                                                    <p class="font-medium text-slate-900 text-sm">
                                                        Priya Sharma
                                                    </p>
                                                </div>
            
                                            </div>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm text-slate-600">
                                                regional.delhi
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-emerald-100 text-emerald-700">
                                                REGIONAL
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-1.5 text-slate-600 text-sm">
                                                <i class="fa-solid fa-map-marker-alt text-amber-500 text-sm"></i>
                                                <span>Region: Delhi</span>
                                            </div>
                                        </td>
            
                                    </tr>
            
                                    <!-- Vikram -->
                                    <tr class="hover:bg-slate-50 transition-colors">
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
            
                                                <div class="user-circle bg-orange-100 text-orange-700 text-sm">
                                                    VI
                                                </div>
            
                                                <div>
                                                    <p class="font-medium text-slate-900 text-sm">
                                                        Vikram Singh
                                                    </p>
                                                </div>
            
                                            </div>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span class="font-mono text-sm text-slate-600">
                                                branch.cp
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-amber-100 text-amber-700">
                                                BRANCH
                                            </span>
                                        </td>
            
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-1.5 text-slate-600 text-sm">
                                                <i class="fa-solid fa-building text-amber-500 text-sm"></i>
                                                <span>Branch: Connaught Place</span>
                                            </div>
                                        </td>
            
                                    </tr>
            
                                </tbody>
            
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- PAGE CONTENT END -->

        </div>
    </div>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>

</body>

</html>