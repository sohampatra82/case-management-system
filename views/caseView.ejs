<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Details - <%= caseData.accountName %>
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        
        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: #1e2937;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 8px;
        }

        .detail-label {
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
        }

        .detail-value {
            font-size: 14.5px;
            color: #0f172a;
            font-weight: 600;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">
    
        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">
    
            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>
    
            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 bg-slate-800 text-white rounded-lg text-xs font-medium sidebar-active">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>
                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>
                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>
                    <a href="/admin-users"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>
                    <a href="/master-data"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-database w-3.5 text-center"></i>
                        Master Data
                    </a>
                </nav>
            </div>
    
            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">
                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">Bank Legal Case Management System
                    </h2>
                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">BLCMS</h2>
                </div>
            <div class="flex items-center gap-2.5">
                <div class="text-right hidden sm:block">
                    <p class="font-semibold text-slate-800 text-xs">
                        <%= currentUser ? currentUser.fullName : 'Anita Verma' %>
                    </p>
                    <p class="text-xs text-emerald-600">
                        <%= currentUser ? currentUser.role : 'SUPER_ADMIN' %>
                            <%= currentUser && currentUser.zone ? `· ${currentUser.zone}` : '· All Zones' %>
                    </p>
                </div>
            
                <div
                    class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                    <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'AV' %>
                            </div>
                        </div>
            </div>

            <!-- ==================== PAGE CONTENT ==================== -->
        <div class="flex-1 overflow-auto p-6">
            <div class="max-w-6xl mx-auto">
        
                <a href="/admin-case"
                    class="inline-flex items-center gap-2 text-slate-600 hover:text-slate-800 font-medium mb-6">
                    <i class="fa-solid fa-arrow-left"></i> Back to All Cases
                </a>
        
                <div class="bg-white rounded-2xl shadow border border-slate-200 overflow-hidden">
        
                    <!-- Header -->
                    <div class="px-8 py-6 border-b flex flex-wrap justify-between items-center gap-4 bg-slate-50">
                        <div>
                            <h2 class="text-3xl font-bold text-slate-900">
                                <%= caseData.borrowerName || caseData.accountName || 'N/A' %>
                            </h2>
                            <p class="text-slate-600 mt-1">
                                <%= caseData.bank?.bankName || caseData.bank || 'N/A' %> •
                                    <%= caseData.branch?.branchName || caseData.branch || 'N/A' %> •
                                        <%= caseData.zone?.zoneName || caseData.zone || 'N/A' %>
                            </p>
                        </div>
        
                        <!-- ✅ Fixed Stage Badge (Server-side) -->
                        <% let stageClass='bg-slate-100 text-slate-700' ; if (caseData.currentStage==='Sale Completed' ||
                            caseData.currentStage==='Completed' ) { stageClass='bg-emerald-100 text-emerald-700' ; } else if
                            (caseData.currentStage && caseData.currentStage.includes('13(4)')) {
                            stageClass='bg-orange-100 text-orange-700' ; } else if (caseData.currentStage &&
                            caseData.currentStage.includes('Possession')) { stageClass='bg-blue-100 text-blue-700' ; } else if
                            (caseData.currentStage && caseData.currentStage.includes('13(2)')) {
                            stageClass='bg-amber-100 text-amber-700' ; } else if (caseData.currentStage==='Sale' ) {
                            stageClass='bg-emerald-100 text-emerald-700' ; } %>
                            <span class="px-5 py-2.5 rounded-full text-sm font-semibold <%= stageClass %>">
                                <%= caseData.currentStage || 'ALLOTMENT' %>
                            </span>
                    </div>
        
                <div class="p-8 space-y-10">
                
                    <!-- Basic Information -->
                    <div>
                        <h3 class="section-title mb-5">Basic Information</h3>
                
                        <div class="info-grid">
                
                            <div>
                                <p class="detail-label">Bank</p>
                                <p class="detail-value">
                                    <%= caseData.bank?.bankName || caseData.bank || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Zone</p>
                                <p class="detail-value">
                                    <%= caseData.zone?.zoneName || caseData.zone || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Region</p>
                                <p class="detail-value">
                                    <%= caseData.region?.regionName || caseData.region || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Branch</p>
                                <p class="detail-value">
                                    <%= caseData.branch?.branchName || caseData.branch || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Borrower Name</p>
                                <p class="detail-value">
                                    <%= caseData.borrowerName || 'N/A' %>
                                </p>
                            </div>
                
                          
                
                        </div>
                    </div>
                
                   
                
                    <!-- Current Status -->
                    <div>
                        <h3 class="section-title mb-5">Current Status</h3>
                
                        <div class="info-grid">
                
                            <div>
                                <p class="detail-label">Current Stage</p>
                                <p class="detail-value">
                                    <%= caseData.currentStage || 'N/A' %>
                                </p>
                            </div>
                
                        </div>
                    </div>
                
                    <!-- SARFAESI Timeline -->
                    <div>
                        <h3 class="section-title mb-5">SARFAESI Timeline</h3>
                
                        <div class="info-grid">
                
                            <div class="bg-slate-50 p-4 rounded-xl">
                                <p class="detail-label">Allotment Date</p>
                                <p class="detail-value">
                                    <%= caseData.allotmentDate ? new Date(caseData.allotmentDate).toLocaleDateString('en-IN') : 'N/A' %>
                                </p>
                            </div>
                
                            <div class="bg-slate-50 p-4 rounded-xl">
                                <p class="detail-label">Notice Date 13(2)</p>
                                <p class="detail-value">
                                    <%= caseData.noticeDate13_2 ? new Date(caseData.noticeDate13_2).toLocaleDateString('en-IN') : 'N/A'
                                        %>
                                </p>
                            </div>
                
                           
                
                            <div class="bg-slate-50 p-4 rounded-xl">
                                <p class="detail-label">Notice Date 13(4)</p>
                                <p class="detail-value">
                                    <%= caseData.noticeDate13_4 ? new Date(caseData.noticeDate13_4).toLocaleDateString('en-IN') : 'N/A'
                                        %>
                                </p>
                            </div>
                
                            <div class="bg-slate-50 p-4 rounded-xl">
                                <p class="detail-label">Publication Date</p>
                                <p class="detail-value">
                                    <%= caseData.publicationDate ? new Date(caseData.publicationDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                        </div>
                    </div>
                
                    <!-- Court / Legal Details -->
                    <div>
                        <h3 class="section-title mb-5">Court / Legal Details</h3>
                
                        <div class="info-grid">
                
                            <div>
                                <p class="detail-label">Court</p>
                                <p class="detail-value">
                                    <%= caseData.court || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Filed By</p>
                                <p class="detail-value">
                                    <%= caseData.filedBy || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Advocate Commissioner</p>
                                <p class="detail-value">
                                    <%= caseData.advocateCommissioner || 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Application Date</p>
                                <p class="detail-value">
                                    <%= caseData.applicationDate ? new Date(caseData.applicationDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Filing Date</p>
                                <p class="detail-value">
                                    <%= caseData.filingDate ? new Date(caseData.filingDate).toLocaleDateString('en-IN') : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Hearing Date</p>
                                <p class="detail-value">
                                    <%= caseData.hearingDate ? new Date(caseData.hearingDate).toLocaleDateString('en-IN') : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Order Date</p>
                                <p class="detail-value">
                                    <%= caseData.orderDate ? new Date(caseData.orderDate).toLocaleDateString('en-IN') : 'N/A' %>
                                </p>
                            </div>
                
                        </div>
                    </div>
                
                    <!-- Possession Details -->
                    <div>
                        <h3 class="section-title mb-5">Possession Details</h3>
                
                        <div class="info-grid">
                
                            <div>
                                <p class="detail-label">Police Letter Date</p>
                                <p class="detail-value">
                                    <%= caseData.policeLetterDate ? new Date(caseData.policeLetterDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Cost Receive Date</p>
                                <p class="detail-value">
                                    <%= caseData.costReceiveDate ? new Date(caseData.costReceiveDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Cost Deposit Date</p>
                                <p class="detail-value">
                                    <%= caseData.costDepositDate ? new Date(caseData.costDepositDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Pre Intimation Date</p>
                                <p class="detail-value">
                                    <%= caseData.preIntimationDate ? new Date(caseData.preIntimationDate).toLocaleDateString('en-IN')
                                        : 'N/A' %>
                                </p>
                            </div>
                
                            <div>
                                <p class="detail-label">Possession Date</p>
                                <p class="detail-value">
                                    <%= caseData.possessionDate ? new Date(caseData.possessionDate).toLocaleDateString('en-IN') : 'N/A'
                                        %>
                                </p>
                            </div>
                
                        </div>
                    </div>
                
                    <!-- Sale Details -->
                    <div>
                        <h3 class="section-title mb-5">Sale Details</h3>
                
                        <div class="info-grid">
                
                            <div>
                                <p class="detail-label">Sale Date</p>
                                <p class="detail-value">
                                    <%= caseData.saleDate ? new Date(caseData.saleDate).toLocaleDateString('en-IN') : 'N/A' %>
                                </p>
                            </div>
                
                        </div>
                    </div>
                
                    <!-- Remarks -->
                    
                        <div>
                            <h3 class="section-title mb-4">Remarks</h3>
                
                        <div id="remarks-display"
                            class="bg-slate-50 border border-slate-200 rounded-2xl p-6 text-slate-700 text-left min-h-[120px]">
                            <p class="detail-value">
                                <%= caseData.initialRemarks ? caseData.initialRemarks : 'N/A' %>
                            </p>
                        </div>
                        </div>
                        
                
                </div>
        
                    <!-- Action Buttons -->
                <!-- Action Buttons - Improved -->
                <div class="border-t bg-slate-50 px-8 py-6">
                    <div class="flex flex-col sm:flex-row gap-4">
                
                        <!-- Edit Button -->
                        <a href="/case-view/edit/<%= caseData._id %>"
                            class="flex-1 flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white py-4 px-6 rounded-2xl font-semibold transition-all duration-200 shadow-sm hover:shadow">
                            <i class="fa-solid fa-pen-to-square text-lg"></i>
                            <span>Edit Case Details</span>
                        </a>
                
                        <!-- Delete Button -->
                        <form action="/case-view/delete/<%= caseData._id %>" method="POST" class="flex-1"
                            onsubmit="return confirm('⚠️ Are you sure you want to permanently delete this case?')">
                
                            <button type="submit"
                                class="w-full flex items-center justify-center gap-3 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white py-4 px-6 rounded-2xl font-semibold transition-all duration-200 shadow-sm hover:shadow">
                                <i class="fa-solid fa-trash-can text-lg"></i>
                                <span>Delete This Case</span>
                            </button>
                        </form>
                    </div>
                
                    <!-- Optional: Small warning text -->
                    <p class="text-center text-xs text-slate-500 mt-4">
                        Deleting a case is permanent and cannot be recovered
                    </p>
                </div>
                </div>
            </div>
        </div>
        </div>
    </div>

<script>
    function getStageClass(stage) {
        if (!stage) return 'bg-slate-100 text-slate-700';
        if (stage === 'Sale Completed' || stage === 'Completed') return 'bg-emerald-100 text-emerald-700';
        if (stage.includes('13(4)')) return 'bg-orange-100 text-orange-700';
        if (stage.includes('Possession')) return 'bg-blue-100 text-blue-700';
        if (stage.includes('13(2)')) return 'bg-amber-100 text-amber-700';
        return 'bg-slate-100 text-slate-700';
    }
</script>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
</body>

</html>