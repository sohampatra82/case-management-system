<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Case - <%= caseData.borrowerName || caseData.accountName %>
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: #1e2937;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 8px;
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Sidebar (same as before) -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i> Dashboard
                    </a>
                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i> Cases
                    </a>
                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i> Reports
                    </a>
                    <a href="/admin-users"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i> Users
                    </a>
                    <a href="/master-data"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-database w-3.5 text-center"></i>
                        Master Data
                    </a>
                </nav>
            </div>

            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i> Logout
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <div class="bg-white border-b px-5 py-3 flex items-center gap-3">
                <button class="md:hidden" onclick="openSidebar()"><i class="fa-solid fa-bars"></i></button>
                <h2 class="font-semibold text-slate-800">Edit Case</h2>
            </div>

            <div class="flex-1 overflow-auto p-6">
                <div class="max-w-5xl mx-auto">
                    <a href="/case-view/<%= caseData._id %>"
                        class="inline-flex items-center gap-2 mb-6 text-slate-600 hover:text-slate-800">
                        <i class="fa-solid fa-arrow-left"></i> Back to Case Details
                    </a>

                    <form action="/case-view/edit/<%= caseData._id %>" method="POST"
                        class="bg-white rounded-3xl shadow border text-sm">
                        <div class="p-8 space-y-10">

                            <!-- Basic Information -->
                            <div>
                                <h3 class="section-title mb-5">Basic Information</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="detail-label block mb-1">Borrower Name</label>
                                        <input type="text" name="borrowerName"
                                            value="<%= caseData.borrowerName || caseData.accountName || '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500"
                                            required>
                                    </div>
                                   
                                    <div>
                                        <label class="detail-label block mb-1">Current Stage</label>
                                        <select name="currentStage"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500"
                                            required>
                                            <option value="ALLOTMENT" <%=caseData.currentStage==='ALLOTMENT'
                                                ? 'selected' : '' %>>ALLOTMENT</option>
                                            <option value="Section 13(2)" <%=caseData.currentStage==='Section 13(2)'
                                                ? 'selected' : '' %>>Section 13(2)</option>
                                            <option value="Section 13(4)" <%=caseData.currentStage==='Section 13(4)'
                                                ? 'selected' : '' %>>Section 13(4)</option>
                                            <option value="Section 14" <%=caseData.currentStage==='Section 14'
                                                ? 'selected' : '' %>>Section 14</option>
                                            <option value="Possession" <%=caseData.currentStage==='Possession'
                                                ? 'selected' : '' %>>Possession</option>
                                            <option value="Sale" <%=caseData.currentStage==='Sale' ? 'selected' : '' %>
                                                >Sale</option>
                                            <option value="Sale Completed" <%=caseData.currentStage==='Sale Completed'
                                                ? 'selected' : '' %>>Sale Completed</option>
                                            <option value="Completed" <%=caseData.currentStage==='Completed'
                                                ? 'selected' : '' %>>Completed</option>
                                            <option value="Close" <%=caseData.currentStage==='Close' ? 'selected' : ''
                                                %>>Close</option>
                                        </select>
                                    </div>
                                <!-- Inside Basic Information grid -->
                                
                                <div>
                                    <label class="detail-label block mb-1">Bank</label>
                                    <select name="bank"
                                        class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                        <% banks.forEach(bank=> { %>
                                            <option value="<%= bank._id %>" <%=String(caseData.bank?._id || caseData.bank)===String(bank._id)
                                                ? 'selected' : '' %>>
                                                <%= bank.bankName %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>
                                
                                <div>
                                    <label class="detail-label block mb-1">Zone</label>
                                    <select name="zone"
                                        class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                        <% zones.forEach(zone=> { %>
                                            <option value="<%= zone._id %>" <%=String(caseData.zone?._id || caseData.zone)===String(zone._id)
                                                ? 'selected' : '' %>>
                                                <%= zone.zoneName %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>
                                
                                <div>
                                    <label class="detail-label block mb-1">Region</label>
                                    <select name="region"
                                        class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                        <% regions.forEach(region=> { %>
                                            <option value="<%= region._id %>" <%=String(caseData.region?._id || caseData.region)===String(region._id)
                                                ? 'selected' : '' %>>
                                                <%= region.regionName %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>
                                
                                <div>
                                    <label class="detail-label block mb-1">Branch</label>
                                    <select name="branch"
                                        class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                        <% branches.forEach(branch=> { %>
                                            <option value="<%= branch._id %>" <%=String(caseData.branch?._id || caseData.branch)===String(branch._id)
                                                ? 'selected' : '' %>>
                                                <%= branch.branchName %>
                                            </option>
                                            <% }); %>
                                    </select>
                                </div>
                                </div>

                                <!-- Property Address -->
                              
                            </div>

                            <!-- Court & Legal Details -->
                            <div>
                                <h3 class="section-title mb-5">Court & Legal Details</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="detail-label block mb-1">Court</label>
                                        <input type="text" name="court" value="<%= caseData.court || '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Filed By</label>
                                        <input type="text" name="filedBy" value="<%= caseData.filedBy || '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Advocate Commissioner</label>
                                        <input type="text" name="advocateCommissioner"
                                            value="<%= caseData.advocateCommissioner || '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Application Date</label>
                                        <input type="date" name="applicationDate"
                                            value="<%= caseData.applicationDate ? caseData.applicationDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Filing Date</label>
                                        <input type="date" name="filingDate"
                                            value="<%= caseData.filingDate ? caseData.filingDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Hearing Date</label>
                                        <input type="date" name="hearingDate"
                                            value="<%= caseData.hearingDate ? caseData.hearingDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div>
                                        <label class="detail-label block mb-1">Order Date</label>
                                        <input type="date" name="orderDate"
                                            value="<%= caseData.orderDate ? caseData.orderDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                </div>
                            </div>

                            <!-- Key Dates -->
                            <div>
                                <h3 class="section-title mb-5">Key Dates</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div><label class="detail-label block mb-1">Allotment Date</label>
                                        <input type="date" name="allotmentDate"
                                            value="<%= caseData.allotmentDate ? caseData.allotmentDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">13(2) Notice Date</label>
                                        <input type="date" name="noticeDate13_2"
                                            value="<%= caseData.noticeDate13_2 ? caseData.noticeDate13_2.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Ack Date</label>
                                        <input type="date" name="ackDate"
                                            value="<%= caseData.ackDate ? caseData.ackDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">13(4) Notice Date</label>
                                        <input type="date" name="noticeDate13_4"
                                            value="<%= caseData.noticeDate13_4 ? caseData.noticeDate13_4.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Publication Date</label>
                                        <input type="date" name="publicationDate"
                                            value="<%= caseData.publicationDate ? caseData.publicationDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Police Letter Date</label>
                                        <input type="date" name="policeLetterDate"
                                            value="<%= caseData.policeLetterDate ? caseData.policeLetterDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Cost Receive Date</label>
                                        <input type="date" name="costReceiveDate"
                                            value="<%= caseData.costReceiveDate ? caseData.costReceiveDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Cost Deposit Date</label>
                                        <input type="date" name="costDepositDate"
                                            value="<%= caseData.costDepositDate ? caseData.costDepositDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Pre Intimation Date</label>
                                        <input type="date" name="preIntimationDate"
                                            value="<%= caseData.preIntimationDate ? caseData.preIntimationDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Possession Date</label>
                                        <input type="date" name="possessionDate"
                                            value="<%= caseData.possessionDate ? caseData.possessionDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                    <div><label class="detail-label block mb-1">Sale Date</label>
                                        <input type="date" name="saleDate"
                                            value="<%= caseData.saleDate ? caseData.saleDate.toISOString().split('T')[0] : '' %>"
                                            class="w-full px-4 py-3 border border-slate-300 rounded-2xl">
                                    </div>
                                </div>
                            </div>

                            <!-- Remarks -->
                            <div>
                                <h3 class="section-title mb-4">Remarks</h3>
                                <textarea name="initialRemarks" rows="5"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-2xl focus:outline-none focus:border-blue-500"><%= caseData.initialRemarks || '' %></textarea>
                            </div>

                        </div>

                        <!-- Form Actions -->
                        <div class="border-t bg-slate-50 px-8 py-6 flex gap-4">
                            <button type="submit"
                                class="flex-1 bg-blue-700 hover:bg-blue-800 text-white py-4 rounded-2xl font-semibold flex items-center justify-center gap-2 transition">
                                <i class="fa-solid fa-floppy-disk"></i> Save Changes
                            </button>
                            <a href="/case-view/<%= caseData._id %>"
                                class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-800 py-4 rounded-2xl font-semibold text-center transition">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
</body>

</html>