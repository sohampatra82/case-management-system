<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .action-card {
            transition: all 0.2s ease;
        }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">

                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>

                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>

                    <a href="/admin-users"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>

                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0">
        <div class="bg-white border-b px-5 py-3 flex items-center gap-3">
            <button class="md:hidden" onclick="openSidebar()"><i class="fa-solid fa-bars"></i></button>
            <h2 class="font-semibold text-slate-800">Edit Case</h2>
        </div>

        <div class="flex-1 overflow-auto p-6">
            <div class="max-w-5xl mx-auto">
                <a href="/case-view/<%= caseData._id %>" class="inline-flex items-center gap-2 mb-6 text-slate-600 hover:text-slate-800">
                    <i class="fa-solid fa-arrow-left"></i> Back to Case Details
                </a>

                <form action="/case-view/edit/<%= caseData._id %>" method="POST" class="bg-white rounded-2xl shadow border">
                    <div class="p-8 space-y-10">

                        <div>
                            <h3 class="section-title mb-5">Basic Information</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="detail-label block mb-1">Account Name</label>
                                    <input type="text" name="accountName" value="<%= caseData.accountName || '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl" required>
                                </div>
                                <div>
                                    <label class="detail-label block mb-1">Bank</label>
                                    <select name="bank" class="w-full px-4 py-3 border border-slate-300 rounded-xl" required>
                                        <option value="SBI" <%= caseData.bank === 'SBI' ? 'selected' : '' %>>SBI</option>
                                        <option value="Punjab National Bank" <%= caseData.bank === 'Punjab National Bank' ? 'selected' : '' %>>Punjab National Bank</option>
                                        <option value="HDFC Bank" <%= caseData.bank === 'HDFC Bank' ? 'selected' : '' %>>HDFC Bank</option>
                                        <option value="ICICI Bank" <%= caseData.bank === 'ICICI Bank' ? 'selected' : '' %>>ICICI Bank</option>
                                        <option value="Axis Bank" <%= caseData.bank === 'Axis Bank' ? 'selected' : '' %>>Axis Bank</option>
                                        <option value="Bank of Baroda" <%= caseData.bank === 'Bank of Baroda' ? 'selected' : '' %>>Bank of Baroda</option>
                                        <option value="Canara Bank" <%= caseData.bank === 'Canara Bank' ? 'selected' : '' %>>Canara Bank</option>
                                        <option value="Union Bank" <%= caseData.bank === 'Union Bank' ? 'selected' : '' %>>Union Bank</option>
                                        <option value="Bank of India" <%= caseData.bank === 'Bank of India' ? 'selected' : '' %>>Bank of India</option>
                                        <option value="Indian Bank" <%= caseData.bank === 'Indian Bank' ? 'selected' : '' %>>Indian Bank</option>
                                        <option value="Central Bank of India" <%= caseData.bank === 'Central Bank of India' ? 'selected' : '' %>>Central Bank of India</option>
                                        <option value="Yes Bank" <%= caseData.bank === 'Yes Bank' ? 'selected' : '' %>>Yes Bank</option>
                                        <option value="IndusInd Bank" <%= caseData.bank === 'IndusInd Bank' ? 'selected' : '' %>>IndusInd Bank</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="detail-label block mb-1">Zone</label>
                                    <select name="zone" class="w-full px-4 py-3 border border-slate-300 rounded-xl" required>
                                        <option value="North" <%= caseData.zone === 'North' ? 'selected' : '' %>>North</option>
                                        <option value="South" <%= caseData.zone === 'South' ? 'selected' : '' %>>South</option>
                                        <option value="East" <%= caseData.zone === 'East' ? 'selected' : '' %>>East</option>
                                        <option value="West" <%= caseData.zone === 'West' ? 'selected' : '' %>>West</option>
                                        <option value="Central" <%= caseData.zone === 'Central' ? 'selected' : '' %>>Central</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="detail-label block mb-1">Branch</label>
                                    <input type="text" name="branch" value="<%= caseData.branch || '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl">
                                </div>
                                <div>
                                    <label class="detail-label block mb-1">Current Stage</label>
                                    <select name="currentStage" class="w-full px-4 py-3 border border-slate-300 rounded-xl" required>
                                        <option value="ALLOTMENT" <%= caseData.currentStage === 'ALLOTMENT' ? 'selected' : '' %>>ALLOTMENT</option>
                                        <option value="Section 13(2)" <%= caseData.currentStage === 'Section 13(2)' ? 'selected' : '' %>>Section 13(2)</option>
                                        <option value="Section 13(4)" <%= caseData.currentStage === 'Section 13(4)' ? 'selected' : '' %>>Section 13(4)</option>
                                        <option value="Section 14" <%= caseData.currentStage === 'Section 14' ? 'selected' : '' %>>Section 14</option>
                                        <option value="Possession" <%= caseData.currentStage === 'Possession' ? 'selected' : '' %>>Possession</option>
                                        <option value="Sale" <%= caseData.currentStage === 'Sale' ? 'selected' : '' %>>Sale</option>
                                        <option value="Close" <%= caseData.currentStage === 'Close' ? 'selected' : '' %>>Close</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Dates -->
                        <div>
                            <h3 class="section-title mb-5">Key Dates</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div><label class="detail-label block mb-1">Allotment Date</label><input type="date" name="allotmentDate" value="<%= caseData.allotmentDate ? caseData.allotmentDate.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                                <div><label class="detail-label block mb-1">13(2) Notice</label><input type="date" name="noticeDate13_2" value="<%= caseData.noticeDate13_2 ? caseData.noticeDate13_2.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                                <div><label class="detail-label block mb-1">13(4) Notice</label><input type="date" name="noticeDate13_4" value="<%= caseData.noticeDate13_4 ? caseData.noticeDate13_4.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                                <div><label class="detail-label block mb-1">Hearing Date</label><input type="date" name="hearingDate" value="<%= caseData.hearingDate ? caseData.hearingDate.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                                <div><label class="detail-label block mb-1">Possession Date</label><input type="date" name="possessionDate" value="<%= caseData.possessionDate ? caseData.possessionDate.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                                <div><label class="detail-label block mb-1">Sale Date</label><input type="date" name="saleDate" value="<%= caseData.saleDate ? caseData.saleDate.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border border-slate-300 rounded-xl"></div>
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div>
                            <h3 class="section-title mb-4">Remarks</h3>
                            <textarea name="initialRemarks" rows="6" class="w-full px-4 py-3 border border-slate-300 rounded-2xl"><%= caseData.initialRemarks || '' %></textarea>
                        </div>

                    </div>

                    <div class="border-t bg-slate-50 px-8 py-6 flex gap-4">
                        <button type="submit" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white py-4 rounded-xl font-semibold">Save Changes</button>
                        <a href="/case-view/<%= caseData._id %>" class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-800 py-4 rounded-xl font-semibold text-center">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
</body>
</html>