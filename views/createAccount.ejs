<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .action-card {
            transition: all 0.2s ease;
        }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">

                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>

                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>

                    <a href="/admin-users"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>

                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">

                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>

                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">
                        BLCMS
                    </h2>
                </div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            Anita Verma
                        </p>
                        <p class="text-xs text-emerald-600">
                            SUPER_ADMIN · All Zones
                        </p>
                    </div>

                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                        AV
                    </div>
                </div>
            </div>

            <!-- PAGE CONTENT START -->
            <div class="flex-1 overflow-auto p-4 sm:p-6 bg-slate-50">
                <div class="max-w-6xl mx-auto">
            
                    <!-- Header -->
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h1 class="text-sm font-semibold text-slate-900">
                                System Users
                            </h1>
            
                            <p class="text-sm text-slate-600 mt-1">
                                Manage platform access and role scopes.
                            </p>
                        </div>
                    </div>
            
                    <!-- Quick Actions -->
                    <div class="mb-8">
                        <h2 class="text-sm font-semibold text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-500"></i>
                            Quick Actions
                        </h2>
            
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
                            <!-- Card -->
                            <a href="/admin-change-password"
                                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-blue-300 group">
            
                                <div
                                    class="w-10 h-10 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-key text-sm"></i>
                                </div>
            
                                <h3 class="font-semibold text-sm text-slate-900">
                                    Change Password
                                </h3>
            
                                <p class="text-slate-500 text-sm mt-1">
                                    Update your admin password
                                </p>
            
                                <div class="mt-5 text-blue-600 text-sm font-medium flex items-center gap-1">
                                    Manage Password
                                    <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
            
                            <!-- Create Zonal -->
                            <a href="/create-account-zonal"
                                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-violet-300 group">
            
                                <div
                                    class="w-10 h-10 bg-violet-100 text-violet-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-violet-600 group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-map-marker-alt text-sm"></i>
                                </div>
            
                                <h3 class="font-semibold text-sm text-slate-900">
                                    Create Zonal Account
                                </h3>
            
                                <p class="text-slate-500 text-sm mt-1">
                                    Add new Zonal level user
                                </p>
            
                                <div class="mt-5 text-violet-600 text-sm font-medium flex items-center gap-1">
                                    Create Zonal User
                                    <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
            
                            <!-- Create Regional -->
                            <a href="/create-account-regional"
                                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-emerald-300 group">
            
                                <div
                                    class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-city text-sm"></i>
                                </div>
            
                                <h3 class="font-semibold text-sm text-slate-900">
                                    Create Regional Account
                                </h3>
            
                                <p class="text-slate-500 text-sm mt-1">
                                    Add new Regional level user
                                </p>
            
                                <div class="mt-5 text-emerald-600 text-sm font-medium flex items-center gap-1">
                                    Create Regional User
                                    <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
            
                            <!-- Create Branch -->
                            <a href="/create-account-branch"
                                class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-amber-300 group">
            
                                <div
                                    class="w-10 h-10 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                                    <i class="fa-solid fa-building text-sm"></i>
                                </div>
            
                                <h3 class="font-semibold text-sm text-slate-900">
                                    Create Branch Account
                                </h3>
            
                                <p class="text-slate-500 text-sm mt-1">
                                    Add new Branch level user
                                </p>
            
                                <div class="mt-5 text-amber-600 text-sm font-medium flex items-center gap-1">
                                    Create Branch User
                                    <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
            
                        </div>
                    </div>
            
                    <!-- Active Accounts -->
                  
            
                </div>
            </div>
            <!-- PAGE CONTENT END -->

        </div>
    </div>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>

</body>

</html>