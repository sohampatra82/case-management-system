<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case View - <%= caseData.caseNumber || 'SARFAESI' %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }
    </style>
</head>

<body class="bg-slate-50 min-h-screen">

    <div class="max-w-6xl mx-auto p-6">

        <!-- Header Card -->
        <div class="bg-white rounded-xl shadow-sm border mb-6">
            <div class="px-6 py-5 flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-semibold text-slate-800">
                        Case Details
                    </h1>
                    <p class="text-slate-500 mt-1">
                        Case No: <%= caseData.caseNumber || 'N/A' %>
                    </p>
                </div>

                <a href="/regional-case"
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-700 transition">
                    Back
                </a>
            </div>
        </div>

        <!-- Main Details -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- Borrower Information -->
            <div class="bg-white border rounded-xl shadow-sm">
                <div class="px-5 py-4 border-b bg-slate-50 rounded-t-xl">
                    <h2 class="font-semibold text-slate-700">
                        Borrower Information
                    </h2>
                </div>

                <div class="p-5 space-y-4">

                    <div>
                        <label class="text-sm text-slate-500">Borrower Name</label>
                        <p class="font-medium text-slate-800">
                            <%= caseData.borrowerName || 'N/A' %>
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-slate-500">Bank</label>
                        <p class="font-medium">
                            <%= caseData.bank?.bankName || 'N/A' %>
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-slate-500">Zone</label>
                        <p class="font-medium">
                            <%= caseData.zone?.zoneName || 'N/A' %>
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-slate-500">Region</label>
                        <p class="font-medium">
                            <%= caseData.region?.regionName || 'N/A' %>
                        </p>
                    </div>

                    <div>
                        <label class="text-sm text-slate-500">Branch</label>
                        <p class="font-medium">
                            <%= caseData.branch?.branchName || 'N/A' %>
                        </p>
                    </div>

                </div>
            </div>

            <!-- Case Information -->
            <div class="bg-white border rounded-xl shadow-sm">
                <div class="px-5 py-4 border-b bg-slate-50 rounded-t-xl">
                    <h2 class="font-semibold text-slate-700">
                        Case Information
                    </h2>
                </div>

                <div class="p-5 space-y-4">

                    <div>
                        <label class="text-sm text-slate-500">Current Stage</label>
                        <div class="mt-1">
                            <span class="px-3 py-1 text-sm bg-blue-100 text-blue-700 rounded-full">
                                <%= caseData.currentStage || 'N/A' %>
                            </span>
                        </div>
                    </div>

                    <div>
                        <label class="text-sm text-slate-500">Filing Date</label>
                        <p class="font-medium">
                            <%= caseData.createdAt ? new Date(caseData.createdAt).toLocaleDateString('en-IN',{
                                day:'2-digit', month:'long', year:'numeric' }) : 'N/A' %>
                        </p>
                    </div>

                </div>
            </div>

        </div>

    </div>

</body>

</html>