<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Details - <%= caseData.borrowerName || 'SARFAESI' %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: #1e2937;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 8px;
        }

        .detail-label {
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
        }

        .detail-value {
            font-size: 14.5px;
            color: #0f172a;
            font-weight: 600;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }
    </style>
</head>

<body class="bg-slate-50 min-h-screen">

    <div class="max-w-6xl mx-auto p-6">

        <!-- Header -->
        <div class="bg-white rounded-2xl shadow-sm border mb-6 overflow-hidden">
            <div class="px-6 py-5 flex justify-between items-center border-b bg-slate-50">
                <div>
                    <h1 class="text-2xl font-semibold text-slate-800">
                        <%= caseData.borrowerName || 'Case Details' %>
                    </h1>
                    <p class="text-slate-500 mt-1">
                        Case No: <%= caseData.caseNumber || caseData._id %> •
                            <%= caseData.bank?.bankName || 'N/A' %>
                    </p>
                </div>
                <a href="/regional-case"
                    class="px-5 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-slate-700 font-medium flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>

            <!-- Stage Badge -->
            <% let stageClass='bg-slate-100 text-slate-700' ; if (caseData.currentStage==='Sale Completed' ||
                caseData.currentStage==='Completed' ) { stageClass='bg-emerald-100 text-emerald-700' ; } else if
                (caseData.currentStage && caseData.currentStage.includes('13(4)')) {
                stageClass='bg-orange-100 text-orange-700' ; } else if (caseData.currentStage &&
                caseData.currentStage.includes('Possession')) { stageClass='bg-blue-100 text-blue-700' ; } else if
                (caseData.currentStage && caseData.currentStage.includes('13(2)')) {
                stageClass='bg-amber-100 text-amber-700' ; } %>
                <div class="px-6 py-4 flex justify-end">
                    <span class="px-5 py-2.5 rounded-full text-sm font-semibold <%= stageClass %>">
                        <%= caseData.currentStage || 'ALLOTMENT' %>
                    </span>
                </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border p-8 space-y-10">

            <!-- Basic Information -->
            <div>
                <h3 class="section-title mb-5">Basic Information</h3>
                <div class="info-grid">
                    <div>
                        <p class="detail-label">Borrower Name</p>
                        <p class="detail-value">
                            <%= caseData.borrowerName || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Bank</p>
                        <p class="detail-value">
                            <%= caseData.bank?.bankName || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Zone</p>
                        <p class="detail-value">
                            <%= caseData.zone?.zoneName || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Region</p>
                        <p class="detail-value">
                            <%= caseData.region?.regionName || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Branch</p>
                        <p class="detail-value">
                            <%= caseData.branch?.branchName || 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Current Status -->
            <div>
                <h3 class="section-title mb-5">Current Status</h3>
                <div class="info-grid">
                    <div>
                        <p class="detail-label">Current Stage</p>
                        <p class="detail-value">
                            <%= caseData.currentStage || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Filing Date</p>
                        <p class="detail-value">
                            <%= caseData.createdAt ? new Date(caseData.createdAt).toLocaleDateString('en-IN', {
                                day:'2-digit', month:'long', year:'numeric' }) : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- SARFAESI Timeline -->
            <div>
                <h3 class="section-title mb-5">SARFAESI Timeline</h3>
                <div class="info-grid">
                    <div class="bg-slate-50 p-4 rounded-xl">
                        <p class="detail-label">Allotment Date</p>
                        <p class="detail-value">
                            <%= caseData.allotmentDate ? new Date(caseData.allotmentDate).toLocaleDateString('en-IN')
                                : 'N/A' %>
                        </p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl">
                        <p class="detail-label">Notice Date 13(2)</p>
                        <p class="detail-value">
                            <%= caseData.noticeDate13_2 ? new Date(caseData.noticeDate13_2).toLocaleDateString('en-IN')
                                : 'N/A' %>
                        </p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl">
                        <p class="detail-label">Notice Date 13(4)</p>
                        <p class="detail-value">
                            <%= caseData.noticeDate13_4 ? new Date(caseData.noticeDate13_4).toLocaleDateString('en-IN')
                                : 'N/A' %>
                        </p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-xl">
                        <p class="detail-label">Publication Date</p>
                        <p class="detail-value">
                            <%= caseData.publicationDate ? new
                                Date(caseData.publicationDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Court / Legal Details -->
            <div>
                <h3 class="section-title mb-5">Court / Legal Details</h3>
                <div class="info-grid">
                    <div>
                        <p class="detail-label">Court</p>
                        <p class="detail-value">
                            <%= caseData.court || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Filed By</p>
                        <p class="detail-value">
                            <%= caseData.filedBy || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Advocate Commissioner</p>
                        <p class="detail-value">
                            <%= caseData.advocateCommissioner || 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Application Date</p>
                        <p class="detail-value">
                            <%= caseData.applicationDate ? new
                                Date(caseData.applicationDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Filing Date</p>
                        <p class="detail-value">
                            <%= caseData.filingDate ? new Date(caseData.filingDate).toLocaleDateString('en-IN') : 'N/A'
                                %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Hearing Date</p>
                        <p class="detail-value">
                            <%= caseData.hearingDate ? new Date(caseData.hearingDate).toLocaleDateString('en-IN')
                                : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Order Date</p>
                        <p class="detail-value">
                            <%= caseData.orderDate ? new Date(caseData.orderDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Possession Details -->
            <div>
                <h3 class="section-title mb-5">Possession Details</h3>
                <div class="info-grid">
                    <div>
                        <p class="detail-label">Police Letter Date</p>
                        <p class="detail-value">
                            <%= caseData.policeLetterDate ? new
                                Date(caseData.policeLetterDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Cost Receive Date</p>
                        <p class="detail-value">
                            <%= caseData.costReceiveDate ? new
                                Date(caseData.costReceiveDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Cost Deposit Date</p>
                        <p class="detail-value">
                            <%= caseData.costDepositDate ? new
                                Date(caseData.costDepositDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Pre Intimation Date</p>
                        <p class="detail-value">
                            <%= caseData.preIntimationDate ? new
                                Date(caseData.preIntimationDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                    <div>
                        <p class="detail-label">Possession Date</p>
                        <p class="detail-value">
                            <%= caseData.possessionDate ? new Date(caseData.possessionDate).toLocaleDateString('en-IN')
                                : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Sale Details -->
            <div>
                <h3 class="section-title mb-5">Sale Details</h3>
                <div class="info-grid">
                    <div>
                        <p class="detail-label">Sale Date</p>
                        <p class="detail-value">
                            <%= caseData.saleDate ? new Date(caseData.saleDate).toLocaleDateString('en-IN') : 'N/A' %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Remarks -->
        <div>
            <div class="flex items-center justify-between mb-4">
                <h3 class="section-title">Remarks</h3>
        
                <button onclick="editRemarks()" id="edit-btn"
                    class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-50 rounded-xl transition-colors">
                    <i class="fa-solid fa-pen"></i>
                    <span>Edit Remarks</span>
                </button>
            </div>
        
            <div id="remarks-display"
                class="bg-slate-50 border border-slate-200 rounded-2xl p-6 text-slate-700 text-left min-h-[120px]">
                <p class="detail-value">
                    <%= caseData.initialRemarks ? caseData.initialRemarks : 'N/A' %>
                </p>
            </div>
        
            <!-- Edit Mode -->
            <div id="remarks-edit" class="hidden">
                <textarea id="remarks-textarea"
                    class="w-full h-40 p-5 border border-slate-300 rounded-2xl focus:outline-none focus:border-emerald-500 resize-y"
                    placeholder="Write your remarks here..."><%= caseData.initialRemarks || '' %></textarea>
        
                <div class="flex gap-3 mt-4">
                <button onclick="saveRemarks()"
                    class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-medium">
                    <i class="fas fa-pen-to-square mr-2"></i>
                    Save Remarks
                </button>
                    <button onclick="cancelEdit()"
                        class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 py-3 rounded-xl font-medium">
                        <i class="fas fa-times mr-2"></i>
                        Cancel
                    </button>
                </div>
            </div>
        </div>
<!-- <a href="/regional-case-feedback"
    class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 rounded-xl font-medium rounded-xl">
    <i class="fa-solid fa-comments"></i>
    Case Feedback
</a> -->
        </div>
    </div>

<script>
    async function saveRemarks() {
        const textarea = document.getElementById('remarks-textarea');
        const newRemarks = textarea.value.trim();
        const caseId = "<%= caseData._id %>";

        if (!caseId) {
            alert("Case ID not found");
            return;
        }

        try {
            const response = await fetch(`/regional-case/${caseId}/remarks`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ initialRemarks: newRemarks })
            });

            const result = await response.json();

            if (result.success) {
                const displayDiv = document.getElementById('remarks-display');
                displayDiv.innerHTML = newRemarks
                    ? newRemarks.replace(/\n/g, '<br>')
                    : '<span class="text-slate-400 italic">N/A</span>';

                cancelEdit();
                alert("✅ Remarks updated successfully!");
            } else {
                alert(result.message || "Failed to save remarks");
            }
        } catch (error) {
            console.error(error);
            alert("Error connecting to server");
        }
    }

    // editRemarks() and cancelEdit() functions remain the same
    function editRemarks() {
        document.getElementById('remarks-display').classList.add('hidden');
        document.getElementById('remarks-edit').classList.remove('hidden');
        document.getElementById('edit-btn').classList.add('hidden');
    }

    function cancelEdit() {
        document.getElementById('remarks-display').classList.remove('hidden');
        document.getElementById('remarks-edit').classList.add('hidden');
        document.getElementById('edit-btn').classList.remove('hidden');
    }
</script>


</body>

</html>