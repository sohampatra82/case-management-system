<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console - Branch Reports</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/branch-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i> Dashboard
                    </a>
                    <a href="/branch-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i> Cases
                    </a>
                    <a href="/branch-reports"
                        class="flex items-center gap-2 px-3 py-2 bg-slate-800 text-white rounded-lg text-xs font-medium sidebar-active">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i> Reports
                    </a>
                </nav>
            </div>

            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i> Logout
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">
                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="text-sm font-semibold text-slate-800">Bank Legal Case Management System</h2>
                </div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            <%= currentUser ? currentUser.fullName : 'Branch User' %>
                        </p>
                        <p class="text-xs text-emerald-600">
                            <%= currentUser ? currentUser.role.toUpperCase() : 'BRANCH' %>
                                <%= currentUser && currentUser.branchName ? `· ${currentUser.branchName}` : '' %>
                        </p>
                    </div>
                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs">
                        <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'BU' %>
                    </div>
                </div>
            </div>

            <!-- Reports Content -->
            <div class=" flex-1 overflow-auto p-6">
                            <div class="flex justify-between items-start mb-6">
                                <div>
                                    <h1 class="text-xl font-semibold text-slate-800">Branch Reports & Analytics</h1>
                                    <p class="text-slate-500 text-xs">Case distribution and performance overview</p>
                                </div>
                                <button onclick="downloadCSV()"
                                    class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-xs font-medium">
                                    <i class="fa-solid fa-download"></i> Export CSV
                                </button>
                            </div>

                            <!-- Tabs -->
                            <div class="flex bg-slate-100 p-1 rounded-2xl w-fit mb-8">
                                <button onclick="switchTab(0)"
                                    class="tab-active tab-btn px-5 py-2.5 rounded-xl text-xs">By Stage</button>
                                <button onclick="switchTab(1)"
                                    class="tab-btn px-5 py-2.5 rounded-xl text-xs text-slate-600 hover:text-slate-800">By
                                    Bank</button>
                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                <!-- Chart -->
                                <div class="bg-white rounded-3xl shadow-sm p-6">
                                    <h3 id="chartTitle" class="text-base font-semibold mb-1">Stage Distribution</h3>
                                    <p id="chartSubtitle" class="text-slate-500 text-xs mb-6">Visual breakdown by stage
                                    </p>
                                    <div style="height:380px">
                                        <canvas id="mainChart"></canvas>
                                    </div>
                                </div>

                                <!-- Table -->
                                <div class="bg-white rounded-3xl shadow-sm p-6">
                                    <h3 id="tableTitle" class="text-base font-semibold mb-4">Stage Summary</h3>
                                    <p id="tableSubtitle" class="text-slate-500 text-xs mb-4">Detailed counts by stage
                                    </p>
                                    <table class="w-full text-xs">
                                        <thead>
                                            <tr class="border-b">
                                                <th id="colName" class="text-left py-3 font-medium text-slate-600">Stage
                                                </th>
                                                <th class="text-right py-3 font-medium text-slate-600">Total Cases</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tableBody" class="divide-y text-xs"></tbody>
                                    </table>
                                </div>
                            </div>
                    </div>
                </div>
            </div>

            <script>
                let allCases = [];
                let mainChart;
                let currentTab = 0;

                async function loadReports() {
                    try {
                        const res = await fetch('/branch-reports/data');
                        allCases = await res.json();
                        switchTab(0);
                    } catch (err) {
                        console.error(err);
                    }
                }

                function switchTab(tab) {
                    currentTab = tab;
                    document.querySelectorAll('.tab-btn').forEach((btn, i) => {
                        if (i === tab) {
                            btn.classList.add('bg-white', 'shadow', 'font-medium');
                        } else {
                            btn.classList.remove('bg-white', 'shadow', 'font-medium');
                        }
                    });

                    if (tab === 0) renderStage();
                    if (tab === 1) renderBank();
                }

                function renderStage() {
                    updateHeaders(
                        "Stage Distribution",
                        "Visual breakdown by current stage",
                        "Stage Summary",
                        "Detailed counts by stage",
                        "Stage Name"
                    );

                    const map = {};
                    allCases.forEach(c => {
                        map[c.currentStage] = (map[c.currentStage] || 0) + 1;
                    });
                    renderChartAndTable(map);
                }

                function renderBank() {
                    updateHeaders(
                        "Bank Distribution",
                        "Visual breakdown by bank",
                        "Bank Summary",
                        "Detailed counts by bank",
                        "Bank Name"
                    );

                    const map = {};
                    allCases.forEach(c => {
                        map[c.bank] = (map[c.bank] || 0) + 1;
                    });
                    renderChartAndTable(map);
                }

                function updateHeaders(chartTitle, chartSubtitle, tableTitle, tableSubtitle, colName) {
                    document.getElementById("chartTitle").textContent = chartTitle;
                    document.getElementById("chartSubtitle").textContent = chartSubtitle;
                    document.getElementById("tableTitle").textContent = tableTitle;
                    document.getElementById("tableSubtitle").textContent = tableSubtitle;
                    document.getElementById("colName").textContent = colName;
                }

                function renderChartAndTable(dataMap) {
                    const labels = Object.keys(dataMap);
                    const values = Object.values(dataMap);

                    if (mainChart) mainChart.destroy();

                    mainChart = new Chart(document.getElementById("mainChart"), {
                        type: "bar",
                        data: {
                            labels,
                            datasets: [{
                                data: values,
                                backgroundColor: ["#3b82f6", "#22c55e", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899"],
                                borderRadius: 8
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: { y: { beginAtZero: true } }
                        }
                    });

                    const tbody = document.getElementById("tableBody");
                    tbody.innerHTML = "";

                    Object.entries(dataMap)
                        .sort((a, b) => b[1] - a[1])
                        .forEach(([name, count]) => {
                            tbody.innerHTML += `
                        <tr>
                            <td class="py-3">${name || '-'}</td>
                            <td class="py-3 text-right font-medium">${count}</td>
                        </tr>`;
                        });
                }

                  function downloadCSV() {
                        window.location.href = "/branch-reports/download/csv";
                    }

                window.onload = loadReports;
            </script>

            <script>
                function logout() {
                    if (confirm('Logout?')) window.location.href = '/';
                }
                function openSidebar() {
                    document.getElementById('sidebar').classList.add('open');
                    document.getElementById('sidebarOverlay').classList.add('active');
                }
                function closeSidebar() {
                    document.getElementById('sidebar').classList.remove('open');
                    document.getElementById('sidebarOverlay').classList.remove('active');
                }
            </script>
</body>

</html>