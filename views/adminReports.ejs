<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console - Reports</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');
    
        body {
            font-family: 'Inter', system-ui, sans-serif;
        }
    
        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }
    
        #sidebarOverlay {
            display: none;
        }
    
        #sidebarOverlay.active {
            display: block;
        }
    
        #sidebar {
            transition: transform 0.25s ease;
        }
    
        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }
    
            #sidebar.open {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i> Dashboard
                    </a>
                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i> Cases
                    </a>
                    <a href="/admin-reports"
                        class="sidebar-active flex items-center gap-2 px-3 py-2 text-white rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i> Reports
                    </a>
                    <a href="/admin-users"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i> Users
                    </a>
                    <a href="/master-data"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-database w-3.5 text-center"></i>
                        Master Data
                    </a>
                </nav>
            </div>

            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i> Logout
                </button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0">
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">
                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>
                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">BLCMS</h2>
                </div>
            <div class="flex items-center gap-2.5">
                <div class="text-right hidden sm:block">
                    <p class="font-semibold text-slate-800 text-xs">
                        <%= currentUser ? currentUser.fullName : 'Anita Verma' %>
                    </p>
                    <p class="text-xs text-emerald-600">
                        <%= currentUser ? currentUser.role : 'SUPER_ADMIN' %>
                            <%= currentUser && currentUser.zone ? `· ${currentUser.zone}` : '· All Zones' %>
                    </p>
                </div>
            
                <div
                    class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                    <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'AV' %>
                            </div>
                        </div>
            </div>

            <!-- Reports Content -->
            
            
            <!-- Reports Content -->
            <div class="flex-1 overflow-auto p-6">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h1 class="text-xl font-semibold text-slate-800">Reports & Analytics</h1>
                        <p class="text-slate-500 text-xs">View distribution and export data.</p>
                    </div>
                    <div class="flex gap-3">
                        <button onclick="downloadCSV()"
                            class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl text-xs font-medium">
                            <i class="fa-solid fa-download"></i> Export CSV
                        </button>
                        
                    </div>
                </div>
            
                <!-- Tabs -->
                <div class="flex bg-slate-100 p-1 rounded-2xl w-fit mb-8">
                    <button onclick="switchTab(0)" class="tab-active tab-btn px-5 py-2.5 rounded-xl text-xs">By Zone</button>
                    <button onclick="switchTab(1)"
                        class="tab-btn px-5 py-2.5 rounded-xl text-xs text-slate-600 hover:text-slate-800">By Region</button>
                    <button onclick="switchTab(2)"
                        class="tab-btn px-5 py-2.5 rounded-xl text-xs text-slate-600 hover:text-slate-800">By Branch</button>
                    <button onclick="switchTab(3)"
                        class="tab-btn px-5 py-2.5 rounded-xl text-xs text-slate-600 hover:text-slate-800">By Stage</button>
                </div>
            
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white rounded-3xl shadow-sm p-6">
                        <h3 class="text-base font-semibold mb-1" id="chartTitle">Zone Distribution Chart</h3>
                        <p class="text-slate-500 text-xs mb-6" id="chartSubtitle">Visual breakdown by zone</p>
                        <div style="height: 380px;">
                            <canvas id="mainChart"></canvas>
                        </div>
                    </div>
            
                    <div class="bg-white rounded-3xl shadow-sm p-6">
                        <h3 class="text-base font-semibold mb-4" id="tableTitle">Zone Summary Table</h3>
                        <p class="text-slate-500 text-xs mb-4" id="tableSubtitle">Detailed counts by zone</p>
            
                        <table class="w-full text-xs" id="summaryTable">
                            <thead>
                                <tr class="border-b">
                                    <th class="text-left py-3 font-medium text-slate-600" id="colName">Zone Name</th>
                                    <th class="text-right py-3 font-medium text-slate-600">Total Cases</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody" class="divide-y text-xs"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>

    <script>
    let mainChart;
    let currentTab = 0;
    let allCases = [];

    async function loadReports() {
        try {
            const res = await fetch('/admin-case/data');
            allCases = await res.json();
            switchTab(0);
        } catch (err) {
            console.error(err);
        }
    }

    function switchTab(tab) {
        currentTab = tab;
        document.querySelectorAll('.tab-btn').forEach((btn, i) => btn.classList.toggle('tab-active', i === tab));
        renderCurrentView();
    }

    function renderCurrentView() {
        if (currentTab === 0) renderZone();
        else if (currentTab === 1) renderRegion();
        else if (currentTab === 2) renderBranch();
        else if (currentTab === 3) renderStage();
    }

    function renderZone() {
        updateHeaders("Zone Distribution Chart", "Visual breakdown by zone", "Zone Summary Table", "Detailed counts by zone", "Zone Name");
        const map = {};
        allCases.forEach(c => map[c.zone] = (map[c.zone] || 0) + 1);
        renderChartAndTable(map);
    }

    function renderRegion() {
        updateHeaders("Region Distribution Chart", "Visual breakdown by region", "Region Summary Table", "Detailed counts by region", "Region Name");
        const map = {};
        allCases.forEach(c => { if (c.region) map[c.region] = (map[c.region] || 0) + 1; });
        renderChartAndTable(map);
    }

    function renderBranch() {
        updateHeaders("Branch Distribution Chart", "Visual breakdown by branch", "Branch Summary Table", "Detailed counts by branch", "Branch Name");
        const map = {};
        allCases.forEach(c => { if (c.branch) map[c.branch] = (map[c.branch] || 0) + 1; });
        renderChartAndTable(map);
    }

    function renderStage() {
        updateHeaders("Stage Distribution Chart", "Visual breakdown by stage", "Stage Summary Table", "Detailed counts by stage", "Stage Name");
        const map = {};
        allCases.forEach(c => map[c.currentStage] = (map[c.currentStage] || 0) + 1);
        renderChartAndTable(map);
    }

    function updateHeaders(chartTitle, chartSub, tableTitle, tableSub, colName) {
        document.getElementById('chartTitle').textContent = chartTitle;
        document.getElementById('chartSubtitle').textContent = chartSub;
        document.getElementById('tableTitle').textContent = tableTitle;
        document.getElementById('tableSubtitle').textContent = tableSub;
        document.getElementById('colName').textContent = colName;
    }

    function renderChartAndTable(dataMap) {
        const labels = Object.keys(dataMap);
        const data = Object.values(dataMap);

        if (mainChart) mainChart.destroy();

        mainChart = new Chart(document.getElementById('mainChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    data,
                    backgroundColor: ['#3b82f6', '#22c55e', '#eab308', '#ef4444', '#8b5cf6', '#ec4899'],
                    borderRadius: 6,
                    barThickness: 45
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => `count : ${ctx.raw}` } }
                },
                scales: {
                    y: { beginAtZero: true },
                    x: { grid: { display: false } }
                }
            }
        });

        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        Object.entries(dataMap).sort((a, b) => b[1] - a[1]).forEach(([name, count]) => {
            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-50";
            tr.innerHTML = `<td class="py-3">${name}</td><td class="py-3 text-right font-medium">${count}</td>`;
            tbody.appendChild(tr);
        });
    }

    function downloadCSV() {
        window.location.href = '/admin-reports/download/csv';   // ← Fixed URL
    }

          function logout() {
                if (confirm('Logout?')) window.location.href = '/';
            }

            function openSidebar() {
                document.getElementById('sidebar').classList.add('open');
                document.getElementById('sidebarOverlay').classList.add('active');
            }

            function closeSidebar() {
                document.getElementById('sidebar').classList.remove('open');
                document.getElementById('sidebarOverlay').classList.remove('active');
            }

    window.onload = loadReports;
</script>
</body>

</html>