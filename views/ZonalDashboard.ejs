<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console - Zonal Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }

        .stat-card {
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">
                    <a href="/zonal-dashboard"
                        class="flex items-center gap-2 px-3 py-2 bg-slate-800 text-white rounded-lg text-xs font-medium sidebar-active">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>
                    <a href="/zonal-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>
                    <a href="/zonal-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>
                 
                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">
                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>
                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">BLCMS</h2>
                </div>

                <div class="flex items-center gap-2.5">
                    <div class="text-right hidden sm:block">
                        <p class="font-semibold text-slate-800 text-xs">
                            <%= currentUser ? currentUser.fullName : 'Zonal User' %>
                        </p>
                        <p class="text-xs text-emerald-600">
                            <%= currentUser ? currentUser.role : 'ZONAL' %>
                                <%= currentUser && currentUser.zoneName ? `· ${currentUser.zoneName}` : '' %>
                        </p>
                    </div>

                    <div
                        class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                        <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'ZU' %>
                    </div>
                </div>
            </div>

            <!-- ==================== PAGE CONTENT START ==================== -->
            <div class=" flex-1 overflow-auto p-4 md:p-5 space-y-5">

                            <!-- Header -->
                            <div class="flex justify-between items-center">
                                <h1 class="text-sm font-semibold text-slate-800">
                                    Zonal Dashboard Overview
                                </h1>

                                <p class="text-[11px] text-slate-500">
                                    Last updated: <%= new Date().toLocaleString('en-IN') %>
                                </p>
                            </div>

                            <!-- Stats Cards -->
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">

                                <!-- Total Cases -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Total Cases</p>
                                            <p class="text-xl font-bold text-slate-800 mt-1">
                                                <%= totalCases || 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600">
                                            <i class="fa-solid fa-briefcase text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Pending -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Pending</p>
                                            <p class="text-xl font-bold text-amber-600 mt-1">
                                                <%= pendingCases || 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600">
                                            <i class="fa-solid fa-clock text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Completed -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Completed</p>
                                            <p class="text-xl font-bold text-emerald-600 mt-1">
                                                <%= completedCases || 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600">
                                            <i class="fa-solid fa-check-circle text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Upcoming Hearings -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Upcoming Hearings</p>
                                            <p class="text-xl font-bold text-purple-600 mt-1">
                                                <%= upcomingHearings ? upcomingHearings.length : 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-purple-100 rounded-xl flex items-center justify-center text-purple-600">
                                            <i class="fa-solid fa-calendar text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Possession Taken -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Possession Taken</p>
                                            <p class="text-xl font-bold text-rose-600 mt-1">
                                                <%= possessionTaken || 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-rose-100 rounded-xl flex items-center justify-center text-rose-600">
                                            <i class="fa-solid fa-hand-holding text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sales Completed -->
                                <div class="bg-white rounded-2xl shadow p-4">
                                    <div class="flex justify-between">
                                        <div>
                                            <p class="text-xs text-slate-500">Sales Completed</p>
                                            <p class="text-xl font-bold text-slate-800 mt-1">
                                                <%= salesCompleted || 0 %>
                                            </p>
                                        </div>
                                        <div
                                            class="w-9 h-9 bg-slate-100 rounded-xl flex items-center justify-center text-slate-600">
                                            <i class="fa-solid fa-sack-dollar text-lg"></i>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <!-- Charts -->
               
           
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                <!-- Left: Stage Funnel -->
                <div class="lg:col-span-7 bg-white rounded-3xl shadow p-5">
                    <h3 class="text-sm font-semibold text-slate-800 mb-4">Case Stages Funnel</h3>
                    <div class="h-72"><canvas id="stageFunnelChart"></canvas></div>
                </div>
            
                <!-- Right: Zone (as you requested) -->
                <div class="lg:col-span-5 bg-white rounded-3xl shadow p-5">
                    <h3 class="text-sm font-semibold text-slate-800 mb-4">Cases by Zone</h3>
                    <div class="h-72"><canvas id="zoneChart"></canvas></div>
                </div>
            </div>
                            <!-- Tables -->
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

                                <!-- Upcoming Hearings -->
                                <div class="lg:col-span-7 bg-white rounded-3xl shadow overflow-hidden">

                                    <div class="px-5 py-4 border-b flex justify-between items-center">
                                        <h3 class="text-sm font-semibold text-slate-800">
                                            Upcoming Hearings (Next 30 Days)
                                        </h3>

                                        <a href="/zonal-case"
                                            class="text-blue-600 hover:text-blue-700 text-xs font-medium flex items-center gap-1">
                                            View All
                                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </div>

                                    <div class="overflow-x-auto">

                                        <% if(upcomingHearings && upcomingHearings.length> 0) { %>

                                            <table class="w-full text-xs">

                                                <thead>
                                                    <tr class="bg-slate-50 text-[11px] text-slate-600">
                                                        <th class="py-3 px-5 text-left">Account Name</th>
                                                        <th class="py-3 px-5 text-left">Bank</th>
                                                        <th class="py-3 px-5 text-left">Stage</th>
                                                        <th class="py-3 px-5 text-left">Hearing Date</th>
                                                        <th class="py-3 px-5 text-left">Court</th>
                                                    </tr>
                                                </thead>

                                                <tbody class="divide-y">

                                                    <% upcomingHearings.forEach(c=> { %>

                                                        <tr class="hover:bg-slate-50">

                                                            <td class="px-5 py-3 font-medium text-xs">
                                                                <%= c.accountName %>
                                                            </td>

                                                            <td class="px-5 py-3 text-xs">
                                                                <%= c.bank?.bankName || 'N/A' %>
                                                            </td>

                                                            <td class="px-5 py-3">
                                                                <span
                                                                    class="px-2 py-1 text-[10px] font-medium rounded-full bg-purple-100 text-purple-700">
                                                                    <%= c.currentStage %>
                                                                </span>
                                                            </td>

                                                            <td class="px-5 py-3 text-xs">
                                                                <%= new Date(c.hearingDate).toLocaleDateString('en-IN')
                                                                    %>
                                                            </td>

                                                            <td class="px-5 py-3 text-xs text-slate-600">
                                                                <%= c.court || '—' %>
                                                            </td>

                                                        </tr>

                                                        <% }) %>

                                                </tbody>

                                            </table>

                                            <% } else { %>

                                                <div class="p-10 text-center text-xs text-slate-400">
                                                    No upcoming hearings scheduled.
                                                </div>

                                                <% } %>

                                    </div>
                                </div>

                                <!-- Recent Activity -->
                                <div class="lg:col-span-5 bg-white rounded-3xl shadow p-5">

                                    <h3 class="text-sm font-semibold text-slate-800 mb-4">
                                        Recent Activity
                                    </h3>

                                    <div class="space-y-4 max-h-[420px] overflow-auto">

                                        <% if(recentActivity && recentActivity.length> 0) { %>

                                            <% recentActivity.forEach(activity=> { %>

                                                <div class="flex gap-3">

                                                    <div
                                                        class="w-8 h-8 bg-slate-100 rounded-xl flex items-center justify-center flex-shrink-0">
                                                        <i class="fa-solid fa-file-lines text-slate-500 text-xs"></i>
                                                    </div>

                                                    <div class="flex-1">

                                                        <div class="flex justify-between items-center">
                                                            <p class="font-medium text-xs">
                                                                <%= activity.accountName || activity.borrowerName %>
                                                            </p>

                                                            <span class="text-[10px] text-slate-500">
                                                                <%= new
                                                                    Date(activity.updatedAt).toLocaleDateString('en-IN')
                                                                    %>
                                                            </span>
                                                        </div>

                                                        <p class="text-xs text-slate-600">
                                                            <%= activity.bank?.bankName || 'N/A' %>
                                                                •
                                                                <%= activity.region?.regionName || 'N/A' %>
                                                        </p>

                                                        <p class="text-[11px] mt-1">
                                                            <span class="text-emerald-600 font-medium">
                                                                Stage Updated:
                                                            </span>
                                                            <%= activity.currentStage %>
                                                        </p>

                                                    </div>

                                                </div>

                                                <% }) %>

                                                    <% } else { %>

                                                        <p class="text-slate-400 text-center text-xs py-10">
                                                            No recent activity yet.
                                                        </p>

                                                        <% } %>

                                    </div>
                                </div>

                            </div>

                    </div>
                    <!-- ==================== PAGE CONTENT END ==================== -->

                </div>
            </div>

            <!-- Chart.js -->
             
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const stageData = <%- JSON.stringify(stageWise || []) %>;
    const zoneData = <%- JSON.stringify(zoneWise || []) %>;

    // Stage Funnel Chart
    new Chart(document.getElementById('stageFunnelChart'), {
        type: 'bar',
        data: {
            labels: stageData.map(s => s._id || "Unknown"),
            datasets: [{
                label: 'Number of Cases',
                data: stageData.map(s => s.count || 0),
                backgroundColor: '#3b82f6',
                borderRadius: 6,
                barThickness: 28
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true } }
        }
    });

    // Zone Chart - Right Side
    new Chart(document.getElementById('zoneChart'), {
        type: 'doughnut',
        data: {
            labels: zoneData.map(z => z._id || "Unknown"),
            datasets: [{
                data: zoneData.map(z => z.count || 0),
                backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 12, padding: 15, font: { size: 11 } }
                },
                tooltip: {
                    callbacks: { label: ctx => `${ctx.label}: ${ctx.raw} Cases` }
                }
            }
        }
    });

    function logout() {
        if (confirm('Logout?')) window.location.href = '/';
    }
    function openSidebar() {
        document.getElementById('sidebar').classList.add('open');
        document.getElementById('sidebarOverlay').classList.add('active');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('active');
    }
</script>
         
</body>

</html>