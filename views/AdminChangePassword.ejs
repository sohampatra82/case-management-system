<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SARFAESI Console</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');

        body {
            font-family: 'Inter', system-ui, sans-serif;
        }

        .sidebar-active {
            background-color: #1e2937;
            border-left: 3px solid #3b82f6;
        }

        #sidebarOverlay {
            display: none;
        }

        #sidebarOverlay.active {
            display: block;
        }

        #sidebar {
            transition: transform 0.25s ease;
        }

        @media (max-width: 768px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100%;
                z-index: 40;
                transform: translateX(-100%);
            }

            #sidebar.open {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body class="bg-slate-100 min-h-screen">

    <!-- Mobile Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-30 md:hidden" onclick="closeSidebar()"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <div id="sidebar" class="w-52 bg-[#0f172a] text-white flex flex-col flex-shrink-0 md:relative md:translate-x-0">

            <!-- Logo -->
            <div class="p-4 border-b border-slate-700 flex items-center gap-2">
                <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-shield-halved text-xs"></i>
                </div>
                <div>
                    <h1 class="text-sm font-semibold tracking-tight">SARFAESI</h1>
                    <p class="text-slate-400 text-xs">Console</p>
                </div>
            </div>

            <!-- Nav -->
            <div class="flex-1 py-3">
                <nav class="px-2 space-y-0.5">

                    <a href="/admin-dashboard"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-gauge-high w-3.5 text-center"></i>
                        Dashboard
                    </a>

                    <a href="/admin-case"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-briefcase w-3.5 text-center"></i>
                        Cases
                    </a>

                    <a href="/admin-reports"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-chart-bar w-3.5 text-center"></i>
                        Reports
                    </a>

                    <a href="/admin-users"
                        class="flex items-center gap-2 px-3 py-2 text-slate-400 hover:bg-slate-800 rounded-lg text-xs font-medium">
                        <i class="fa-solid fa-users w-3.5 text-center"></i>
                        Users
                    </a>

                </nav>
            </div>

            <!-- Logout -->
            <div class="p-3 border-t border-slate-700">
                <button onclick="logout()"
                    class="w-full flex items-center justify-center gap-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 py-2 rounded-xl text-xs font-medium">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    Logout
                </button>
            </div>
        </div>

        <!-- Main -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Topbar -->
            <div class="bg-white border-b flex items-center justify-between px-4 md:px-5 py-2.5">

                <div class="flex items-center gap-3">
                    <button class="md:hidden text-slate-500 hover:text-slate-700" onclick="openSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <h2 class="text-sm font-semibold text-slate-800 hidden sm:block">
                        Bank Legal Case Management System
                    </h2>

                    <h2 class="text-sm font-semibold text-slate-800 sm:hidden">
                        BLCMS
                    </h2>
                </div>

            <div class="flex items-center gap-2.5">
                <div class="text-right hidden sm:block">
                    <p class="font-semibold text-slate-800 text-xs">
                        <%= currentUser ? currentUser.fullName : 'Anita Verma' %>
                    </p>
                    <p class="text-xs text-emerald-600">
                        <%= currentUser ? currentUser.role : 'SUPER_ADMIN' %>
                            <%= currentUser && currentUser.zone ? `· ${currentUser.zone}` : '· All Zones' %>
                    </p>
                </div>
            
                <div
                    class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center text-white font-bold text-xs cursor-pointer">
                    <%= currentUser && currentUser.fullName ? currentUser.fullName.split(" ").map(n => n[0]).join("").toUpperCase().slice(0,2) : 'AV' %>
                            </div>
                        </div>
            </div>

            <!-- PAGE CONTENT START -->
                    <!-- PAGE CONTENT START -->
            <div class="flex-1 overflow-auto bg-gray-50 p-4 md:p-8">
                <div class="max-w-4xl mx-auto">
            
                    <!-- Page Header -->
            
            
                    <!-- Main Card -->
                    <div class="bg-white rounded-3xl shadow-lg border border-gray-100 overflow-hidden">
            
                        <!-- Top Section -->
                   
            
                        <div class="p-6 md:p-8 space-y-10">
            
                            <!-- Username Update -->
                            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center">
                                        <i class="fa-solid fa-user text-blue-600"></i>
                                    </div>
            
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-800">
                                            Change Username
                                        </h3>
                                        <p class="text-sm text-gray-500">
                                            Update your admin username.
                                        </p>
                                    </div>
                                </div>
            
                        <form action="/admin-change-password/update" method="POST">
                        
                            <div class="space-y-6">
                        
                                <!-- Current Username -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        Current Username
                                    </label>
                        
                                    <div class="relative">
                                        <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        
                                        <input type="text" value="<%= admin ? admin.username : 'ADMIN' %>" readonly
                                            class="w-full bg-gray-100 border border-gray-300 rounded-2xl pl-11 pr-4 py-3 text-gray-600">
                                    </div>
                                </div>
                        
                                <!-- New Username -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        New Username
                                    </label>
                        
                                    <div class="relative">
                                        <i class="fa-solid fa-pen absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        
                                        <input type="text" name="newUsername" placeholder="Enter new username"
                                            class="w-full border border-gray-300 rounded-2xl pl-11 pr-4 py-3 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-500 transition">
                                    </div>
                                </div>
                        
                                <!-- Current Password -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        Current Password
                                    </label>
                        
                                    <div class="relative">
                        
                                        <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        
                                        <input type="password" id="currentPassword" name="currentPassword" required
                                            placeholder="Enter current password"
                                            class="w-full border border-gray-300 rounded-2xl pl-11 pr-12 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500 transition">
                        
                                        <button type="button" onclick="togglePassword('currentPassword', 'currentEye')"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        
                                            <i id="currentEye" class="fa-solid fa-eye"></i>
                                        </button>
                        
                                    </div>
                                </div>
                        
                                <!-- New Password -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        New Password
                                    </label>
                        
                                    <div class="relative">
                        
                                        <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        
                                        <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password"
                                            class="w-full border border-gray-300 rounded-2xl pl-11 pr-12 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500 transition">
                        
                                        <button type="button" onclick="togglePassword('newPassword', 'newEye')"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        
                                            <i id="newEye" class="fa-solid fa-eye"></i>
                                        </button>
                        
                                    </div>
                                </div>
                        
                                <!-- Confirm Password -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        Confirm New Password
                                    </label>
                        
                                    <div class="relative">
                        
                                        <i class="fa-solid fa-shield-halved absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        
                                        <input type="password" id="confirmPassword" name="confirmNewPassword" placeholder="Confirm new password"
                                            class="w-full border border-gray-300 rounded-2xl pl-11 pr-12 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500 transition">
                        
                                        <button type="button" onclick="togglePassword('confirmPassword', 'confirmEye')"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                        
                                            <i id="confirmEye" class="fa-solid fa-eye"></i>
                                        </button>
                        
                                    </div>
                                </div>
                        
                                <!-- Submit Button -->
                                <button type="submit"
                                    class="w-full inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-medium shadow-md transition duration-300">
                        
                                    <i class="fa-solid fa-floppy-disk"></i>
                                    Save Changes
                                </button>
                        
                            </div>
                        
                        </form>
                            </div>
            
                        </div>
                    </div>
            
                    <!-- Security Note -->
                    <div class="mt-6 bg-amber-50 border border-amber-200 rounded-2xl p-5 flex items-start gap-4 shadow-sm">
                        <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-shield-halved text-amber-600"></i>
                        </div>
            
                        <div>
                            <h4 class="font-semibold text-amber-800 mb-1">
                                Security Recommendation
                            </h4>
            
                            <p class="text-sm text-amber-700 leading-relaxed">
                                Use a strong password with at least 8 characters,
                                including uppercase letters, lowercase letters,
                                numbers, and special characters for better account security.
                            </p>
                        </div>
                    </div>
            
                </div>
            </div>
                    <!-- PAGE CONTENT END -->

        </div>
    </div>

    <script>
        function logout() {
            if (confirm('Logout?')) window.location.href = '/';
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
<script>
    function togglePassword(inputId, eyeId) {

        const input = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);

        if (input.type === "password") {
            input.type = "text";
            eye.classList.remove("fa-eye");
            eye.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            eye.classList.remove("fa-eye-slash");
            eye.classList.add("fa-eye");
        }
    }
</script>
</body>

</html>